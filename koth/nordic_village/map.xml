<map proto="1.5.1">
<name>Nordic Village</name>
<version>1.0</version>
<objective>Capture and hold the hills to score points</objective>
<phase>staging</phase>
<gamemode>koth</gamemode>
<include id="conquest"/>
<constant id="damage-resistance">3s</constant>
<constant id="respawn-timer">2s</constant>
<authors>
    <author uuid="74271a2f-47c0-4bd7-9a9f-4dc7eaedabe0" /> <!-- killtrixy -->
    <author uuid="f137a892-5dee-449b-93cb-5049a34b141e" /> <!-- k6ren -->
    <author uuid="ec5ec930-5cf3-4f8a-ad9f-09056aeed71b" /> <!-- Tundren -->
</authors>
<contributors>
    <contributor uuid="64e840c8-4fb5-4659-a36b-ff93e2f6113a" contribution="XML"/> <!-- Javg_ -->
</contributors>
<score>
    <limit>750</limit>
</score>
<teams>
    <team id="red" color="red" max="10" max-overfill="12">Red</team>
    <team id="blue" color="blue" max="10" max-overfill="12">Blue</team>
</teams>
<spawns>
    <default>
        <region>
            <point>-20.5,30,-9.5</point>
        </region>
    </default>
    <spawn team="red" kit="base-kit">
        <region yaw="61">
            <point>21.5,15,19.5</point>
        </region>
    </spawn>
    <spawn team="blue" kit="base-kit">
        <region yaw="-61">
            <point>-60.5,15,19.5</point>
        </region>
    </spawn>
</spawns>
<regions>
    <apply block="never" />
    <cuboid id="north-capture" min="-23,2,20" max="-16,4,13" />
    <union id="north-display">
        <cuboid min="-26,11,16" max="-13,23,13" />
        <cuboid min="15,28,21" max="-20,33,16" />
    </union>
    <cuboid id="centre-capture" min="-23,22,40" max="-16,24,47" />
    <cuboid id="centre-display" min="-17,14,36" max="-22,20,37" />
    <cuboid id="south-capture" min="-16,2,58" max="-23,4,65" />
</regions>
<control-points capture-time="4s" required="false" show-progress="true" neutral-state="true" permanent="false" incremental="true">
    <control-point name="Boat" points="1" capture="north-capture" progress="north-capture" captured="north-display" />
    <control-point name="Bridge" points="1" capture="centre-capture" progress="centre-capture" captured="centre-display" />
    <control-point name="Cave" points="1" capture="south-capture" progress="south-capture" />
</control-points>
<spawners>
    <spawner player-region="everywhere" max-entities="1" delay="10s">
        <spawn-region>
            <block>-19.5,1.5,40.5</block>
        </spawn-region>
        <item material="golden apple" />
    </spawner>
</spawners>
</map>
