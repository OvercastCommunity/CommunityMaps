        </region>
    </structure>

    <dynamic structure="blue-defense-4" offset="-280,0,0">
        <filter>
            <variable var="team_one_score">4..</variable>
        </filter>
        <trigger>
            <score team="team-one">4..</score>
        </trigger>
    </dynamic>

    <!-- Red structure for 1 point -->
    <structure id="red-defense-1" air="false">
        <region>
            <cuboid min="38,3,-55" max="43,4,-44"/> <!-- West Spawn Side -->
            <cuboid min="98,3,-55" max="103,4,-44"/> <!-- East Spawn Side -->
            <cuboid min="53,3,-31" max="61,7,-30"/> <!-- West Back Bush -->
            <cuboid min="80,3,-31" max="88,7,-30"/> <!-- East Back Bush -->
            <cuboid min="38,3,-11" max="41,4,-10"/> <!-- West Side Bush -->
            <cuboid min="100,3,-11" max="103,4,-10"/> <!-- East Side Bush -->
            <cuboid min="54,3,-11" max="60,7,-10"/> <!-- West Front Bush -->
            <cuboid min="81,3,-11" max="87,7,-10"/> <!-- East Front Bush -->
            <cuboid min="70,3,-1" max="71,4,0"/> <!-- Block Below Ladder -->
        </region>
    </structure>
    <dynamic structure="red-defense-1" offset="-70,0,0">
        <filter>
            <variable var="team_two_score">1..</variable>
        </filter>
        <trigger>
            <score team="team-two">1..</score>
        </trigger>
    </dynamic>

    <!-- Red structure for 2 points -->
    <structure id="red-defense-2" air="false">
        <region>
            <cuboid min="108,3,-55" max="173,15,-40"/> <!-- Spawn Castle -->
            <cuboid min="123,3,-31" max="131,7,-28"/> <!-- West Back Bush -->
            <cuboid min="150,3,-31" max="158,7,-28"/> <!-- East Back Bush -->
            <cuboid min="108,3,-11" max="112,7,-10"/> <!-- West Side Bush -->
            <cuboid min="169,3,-11" max="173,7,-10"/> <!-- East Side Bush -->
            <cuboid min="124,3,-11" max="130,7,-8"/> <!-- West Front Bush -->
            <cuboid min="151,3,-11" max="157,7,-8"/> <!-- East Front Bush -->
            <cuboid min="140,3,-1" max="141,7,0"/> <!-- Ladder -->
            <cuboid min="137,3,6" max="144,4,8"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="red-defense-2" offset="-140,0,0">
        <filter>
            <variable var="team_two_score">2..</variable>
        </filter>
        <trigger>
            <score team="team-two">2..</score>
        </trigger>
    </dynamic>

