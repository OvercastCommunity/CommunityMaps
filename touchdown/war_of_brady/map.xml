            <cuboid min="248,0,9" max="252,7,12"/> <!-- West Side Bush -->
            <cuboid min="309,0,9" max="313,7,12"/> <!-- East Side Bush -->
            <cuboid min="263,0,9" max="271,7,12"/> <!-- West Front Bush -->
            <cuboid min="290,0,9" max="298,7,12"/> <!-- East Front Bush -->
