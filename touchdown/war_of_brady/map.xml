</constants>
<include id="touchdown"/>
<authors>
    <author uuid="d845eb0b-1ae4-40b7-9287-ec65c22b6e91"/> <!-- Anarquista -->
</authors>
<spawns>
    <default>
        <region yaw="90">
            <point>42.5,24,0.5</point>
        </region>
    </default>
</spawns>
<filters>
    <below id="team-one-4s" z="-21.5"/> <!-- ??? -->
    <below id="team-one-3s" z="0.5"/> <!-- ??? -->
    <above id="team-two-4s" z="22.5"/> <!-- ??? -->
    <above id="team-two-3s" z="0.5"/> <!-- ??? -->
</filters>

<regions>
    <cuboid id="playing-field" min="-33,3,-56" max="33,10,56"/>
    <cuboid id="team-one-portal" min="-32,3,-55" max="32,7,-45"/>
    <cuboid id="team-two-portal" min="-32,3,45" max="32,7,55"/>

    <union id="tower-region">
        <!-- West Blue Tower -->
        <cuboid min="-33,12,44" max="-24,16,57"/>
        <cuboid min="-34,17,43" max="-19,22,58"/>
        <!-- East Blue Tower -->
        <cuboid min="25,12,44" max="34,16,57"/>
        <cuboid min="20,17,43" max="35,22,58"/>
        <!-- West Red Tower -->
        <cuboid min="-33,12,-56" max="-24,16,-43"/>
        <cuboid min="-34,17,-57" max="-19,22,-42"/>
        <!-- East Red Tower -->
        <cuboid min="25,12,-56" max="34,16,-43"/>
        <cuboid min="20,17,-57" max="35,22,-42"/>
    </union>
</regions>

<structures>
    <!-- Blue structure for 1 point -->
    <structure id="blue-defense-1" air="false">
        <region>
            <cuboid min="38,3,45" max="43,4,56"/> <!-- West Spawn Side -->
            <cuboid min="98,3,45" max="103,4,56"/> <!-- East Spawn Side -->
            <cuboid min="53,3,30" max="61,7,31"/> <!-- West Back Bush -->
            <cuboid min="80,3,30" max="88,7,31"/> <!-- East Back Bush -->
            <cuboid min="38,3,10" max="41,4,11"/> <!-- West Side Bush -->
            <cuboid min="100,3,10" max="103,4,11"/> <!-- East Side Bush -->
            <cuboid min="54,3,10" max="60,7,11"/> <!-- West Front Bush -->
            <cuboid min="81,3,10" max="87,7,11"/> <!-- East Front Bush -->
            <cuboid min="70,3,1" max="71,4,2"/> <!-- Ladder Block -->
        </region>
    </structure>
    <dynamic structure="blue-defense-1" offset="-70,0,0">
        <filter>
            <variable var="team_one_score">1..</variable>
        </filter>
        <trigger>
            <score team="team-one">1..</score>
        </trigger>
    </dynamic>

    <!-- Blue structure for 2 points -->
    <structure id="blue-defense-2" air="false">
        <region>
            <cuboid min="108,3,42" max="173,15,56"/> <!-- Spawn Castle -->
            <cuboid min="123,3,28" max="131,7,31"/> <!-- West Back Bush -->
            <cuboid min="150,3,28" max="158,7,31"/> <!-- East Back Bush -->
            <cuboid min="108,3,10" max="112,7,11"/> <!-- West Side Bush -->
            <cuboid min="169,3,10" max="173,7,11"/> <!-- East Side Bush -->
            <cuboid min="124,3,8" max="130,7,11"/> <!-- West Front Bush -->
            <cuboid min="151,3,8" max="157,7,11"/> <!-- East Front Bush -->
            <cuboid min="140,5,1" max="141,7,2"/> <!-- Ladder -->
            <cuboid min="137,3,-7" max="144,4,-5"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="blue-defense-2" offset="-140,0,0">
        <filter>
            <variable var="team_one_score">2..</variable>
        </filter>
        <trigger>
            <score team="team-one">2..</score>
        </trigger>
    </dynamic>

