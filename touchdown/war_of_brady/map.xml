        </region>
    </structure>

    <dynamic structure="blue-defense-4" offset="-280,0,0">
        <filter>
            <variable var="team_one_score">4..</variable>
        </filter>
        <trigger>
            <score team="team-one">4..</score>
        </trigger>
    </dynamic>

    <!-- Red structure for 1 point -->
