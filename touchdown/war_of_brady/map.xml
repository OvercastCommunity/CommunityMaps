        <region>
            <cuboid min="38,3,-55" max="43,4,-44"/> <!-- West Spawn Side -->
            <cuboid min="98,3,-55" max="103,4,-44"/> <!-- East Spawn Side -->
            <cuboid min="53,3,-30" max="61,7,-29"/> <!-- West Back Bush -->
            <cuboid min="80,3,-30" max="88,7,-29"/> <!-- East Back Bush -->
            <cuboid min="38,3,-10" max="41,4,-9"/> <!-- West Side Bush -->
            <cuboid min="100,3,-10" max="103,4,-9"/> <!-- East Side Bush -->
            <cuboid min="54,3,-10" max="60,7,-9"/> <!-- West Front Bush -->
            <cuboid min="81,3,-10" max="87,7,-9"/> <!-- East Front Bush -->
            <cuboid min="70,3,-1" max="71,4,0"/> <!-- Block Below Ladder -->
        </region>
    </structure>
    <dynamic structure="red-defense-1" offset="-70,0,0">
        <filter>
            <variable var="team_two_score">1..</variable>
