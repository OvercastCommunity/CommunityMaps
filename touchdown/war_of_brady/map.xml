            <cuboid min="177,2,42" max="244,15,57"/> <!-- Spawn Castle -->
            <cuboid min="193,0,28" max="201,7,31"/> <!-- West Back Bush -->
            <cuboid min="220,0,28" max="228,7,31"/> <!-- East Back Bush -->
            <cuboid min="178,3,8" max="182,7,11"/> <!-- West Side Bush -->
            <cuboid min="239,3,8" max="243,7,11"/> <!-- East Side Bush -->
            <cuboid min="193,0,8" max="201,7,11"/> <!-- West Front Bush -->
            <cuboid min="220,0,8" max="228,7,11"/> <!-- East Front Bush -->
            <cuboid min="205,3,-7" max="216,8,-4"/> <!-- Mid Wall -->
