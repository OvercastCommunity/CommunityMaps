<map proto="1.5.1">
<name>War of Brady</name>
<version>1.1.0</version>
<created>2026-08-30</created>
<phase>development</phase>
<constants>
    <constant id="team-flag-posts">true</constant> 
    <constant id="team-size">11</constant>
    <constant id="team-one-name">Blue</constant>
    <constant id="team-two-name">Red</constant>
    <constant id="team-one-color">blue</constant>
    <constant id="team-two-color">red</constant>
    <constant id="team-one-spawn">1.5,15,-46.5</constant>
    <constant id="team-one-yaw">0</constant>
    <constant id="team-two-spawn">0.5,15,47.5</constant>
    <constant id="team-two-yaw">180</constant>
    <constant id="flag-post">0.5,7,0.5</constant>
    <constant id="team-one-flag-post">0.5,7,0.5</constant>
    <constant id="team-two-flag-post">0.5,7,0.5</constant>
    <constant id="void-plane">-1</constant>
    <constant id="time-limit">15m</constant>
    <constant id="flag-respawn">7s</constant>
    <constant id="flag-prerespawn">6.8s</constant>
    <constant id="instaheal-default">2</constant>
</constants>

<include id="touchdown"/>

<authors>
    <author uuid="d845eb0b-1ae4-40b7-9287-ec65c22b6e91"/> <!-- Anarquista -->
</authors>

<spawns>
    <default>
        <region yaw="90">
            <cuboid min="40.5,10,-6.5" max="45.5,10,7.5"/>
        </region>
    </default>
</spawns>

<filters>
    <below id="team-one-4s" z="-21.5"/> 
    <below id="team-one-3s" z="0.5"/> 
    <above id="team-two-4s" z="22.5"/> 
    <above id="team-two-3s" z="0.5"/> 
</filters>

<regions>
    <cuboid id="playing-field" min="-33,3,-56" max="33,10,56"/>
    <cuboid id="team-one-portal" min="-32,3,-55" max="32,7,-45"/>
    <cuboid id="team-two-portal" min="-32,3,45" max="32,7,55"/>

    <union id="tower-region">
        <!-- Blue Castle -->
        <cuboid min="-35,17,42" max="36,23,59"/>
        <!-- Red Castle -->
        <cuboid min="-35,17,-58" max="36,23,-41"/>
    </union>
</regions>

<structures>
    <!-- Blue structure for 1 point -->
    <structure id="blue-defense-1" air="false">
        <region>
            <cuboid min="38,3,45" max="43,4,56"/> <!-- West Spawn Side -->
            <cuboid min="98,3,45" max="103,4,56"/> <!-- East Spawn Side -->
            <cuboid min="53,3,31" max="61,7,32"/> <!-- West Back Bush -->
            <cuboid min="80,3,31" max="88,7,32"/> <!-- East Back Bush -->
            <cuboid min="38,3,11" max="41,4,12"/> <!-- West Side Bush -->
            <cuboid min="100,3,11" max="103,4,12"/> <!-- East Side Bush -->
            <cuboid min="54,3,11" max="60,7,12"/> <!-- West Front Bush -->
            <cuboid min="81,3,11" max="87,7,12"/> <!-- East Front Bush -->
            <cuboid min="70,3,1" max="71,4,2"/> <!-- Ladder Block -->
        </region>
    </structure>
    <dynamic structure="blue-defense-1" offset="-70,0,0">
        <filter>
            <variable var="team_one_score">1..</variable>
        </filter>
        <trigger>
            <score team="team-one">1..</score>
        </trigger>
    </dynamic>

    <!-- Blue structure for 2 points -->
    <structure id="blue-defense-2" air="false">
        <region>
            <cuboid min="108,3,42" max="173,15,56"/> <!-- Spawn Castle -->
            <cuboid min="123,3,29" max="131,7,32"/> <!-- West Back Bush -->
            <cuboid min="150,3,29" max="158,7,32"/> <!-- East Back Bush -->
            <cuboid min="108,3,11" max="112,7,12"/> <!-- West Side Bush -->
            <cuboid min="169,3,11" max="173,7,12"/> <!-- East Side Bush -->
            <cuboid min="124,3,9" max="130,7,12"/> <!-- West Front Bush -->
            <cuboid min="151,3,9" max="157,7,12"/> <!-- East Front Bush -->
            <cuboid min="140,3,1" max="141,7,2"/> <!-- Ladder -->
            <cuboid min="137,3,-7" max="144,4,-5"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="blue-defense-2" offset="-140,0,0">
        <filter>
            <variable var="team_one_score">2..</variable>
        </filter>
        <trigger>
            <score team="team-one">2..</score>
        </trigger>
    </dynamic>

    <!-- Blue structure for 3 points -->
    <structure id="blue-defense-3" air="true">
        <region>
            <cuboid min="177,2,42" max="244,15,57"/> <!-- Spawn Castle -->
            <cuboid min="193,0,29" max="201,7,32"/> <!-- West Back Bush -->
            <cuboid min="220,0,29" max="228,7,32"/> <!-- East Back Bush -->
            <cuboid min="178,3,9" max="182,7,12"/> <!-- West Side Bush -->
            <cuboid min="239,3,9" max="243,7,12"/> <!-- East Side Bush -->
            <cuboid min="193,0,9" max="201,7,12"/> <!-- West Front Bush -->
            <cuboid min="220,0,9" max="228,7,12"/> <!-- East Front Bush -->
            <cuboid min="205,3,-7" max="216,8,-4"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="blue-defense-3" offset="-210,0,0">
        <filter>
            <variable var="team_one_score">3..</variable>
