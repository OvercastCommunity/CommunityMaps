            <cuboid min="123,3,-30" max="131,7,-27"/> <!-- West Back Bush -->
            <cuboid min="150,3,-30" max="158,7,-27"/> <!-- East Back Bush -->
            <cuboid min="108,3,-10" max="112,7,-9"/> <!-- West Side Bush -->
            <cuboid min="169,3,-10" max="173,7,-9"/> <!-- East Side Bush -->
            <cuboid min="124,3,-10" max="130,7,-7"/> <!-- West Front Bush -->
            <cuboid min="151,3,-10" max="157,7,-7"/> <!-- East Front Bush -->
            <cuboid min="140,5,-1" max="141,7,0"/> <!-- Ladder -->
            <cuboid min="137,3,6" max="144,4,8"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="red-defense-2" offset="-140,0,0">
        <filter>
            <variable var="team_two_score">2..</variable>
        </filter>
        <trigger>
            <score team="team-two">2..</score>
        </trigger>
    </dynamic>

    <!-- Red structure for 3 points -->
    <structure id="red-defense-3" air="true">
        <region>
            <cuboid min="177,2,-56" max="244,15,-41"/> <!-- Spawn Castle -->
            <cuboid min="193,0,-30" max="201,7,-27"/> <!-- West Back Bush -->
            <cuboid min="220,0,-30" max="228,7,-27"/> <!-- East Back Bush -->
            <cuboid min="178,3,-10" max="182,7,-7"/> <!-- West Side Bush -->
            <cuboid min="239,3,-10" max="243,7,-7"/> <!-- East Side Bush -->
            <cuboid min="193,0,-10" max="201,7,-7"/> <!-- West Front Bush -->
            <cuboid min="220,0,-10" max="228,7,-7"/> <!-- East Front Bush -->
            <cuboid min="205,3,5" max="216,8,8"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="red-defense-3" offset="-210,0,0">
        <filter>
            <variable var="team_two_score">3..</variable>
        </filter>
        <trigger>
            <score team="team-two">3..</score>
        </trigger>
    </dynamic>


    <!-- Red structure for 4 points -->
    <structure id="red-defense-4" air="true">
        <region>
            <cuboid min="246,2,-57" max="315,20,-41"/> <!-- Spawn Castle -->
            <cuboid min="248,0,-10" max="252,7,-7"/> <!-- West Side Bush -->
            <cuboid min="309,0,-10" max="313,7,-7"/> <!-- East Side Bush -->
            <cuboid min="263,0,-10" max="271,7,-7"/> <!-- West Front Bush -->
            <cuboid min="290,0,-10" max="298,7,-7"/> <!-- East Front Bush -->
            <cuboid min="275,3,5" max="286,8,8"/> <!-- Mid Wall -->
        </region>
    </structure>

    <dynamic structure="red-defense-4" offset="-280,0,0">
        <filter>
            <variable var="team_two_score">4..</variable>
        </filter>
        <trigger>
            <score team="team-two">4..</score>
        </trigger>
    </dynamic>
</structures>


<actions>
    <!-- Action when Blue scores: Switch scope to players, but filter to ONLY Red Team (team-two) -->
    <action id="blue-scored-sound" scope="match">
        <switch-scope inner="player" filter="team-two">
            <sound key="random.anvil_use" volume="1" pitch="1" />
        </switch-scope>
    </action>

    <!-- Action when Red scores: Switch scope to players, but filter to ONLY Blue Team (team-one) -->
    <action id="red-scored-sound" scope="match">
        <switch-scope inner="player" filter="team-one">
            <sound key="random.anvil_use" volume="1" pitch="1" />
        </switch-scope>
    </action>

    <!-- Triggers for Blue Team (team-one) - Plays sound to Red -->
    <trigger scope="match"><filter><score team="team-one">1</score></filter><action id="blue-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-one">2</score></filter><action id="blue-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-one">3</score></filter><action id="blue-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-one">4</score></filter><action id="blue-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-one">5</score></filter><action id="blue-scored-sound"/></trigger>

    <!-- Triggers for Red Team (team-two) - Plays sound to Blue -->
    <trigger scope="match"><filter><score team="team-two">1</score></filter><action id="red-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-two">2</score></filter><action id="red-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-two">3</score></filter><action id="red-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-two">4</score></filter><action id="red-scored-sound"/></trigger>
    <trigger scope="match"><filter><score team="team-two">5</score></filter><action id="red-scored-sound"/></trigger>
    
    <!-- When the player is inside the 'tower region', a pulse filters gives them one arrow every 5 seconds (they don't stack) --> 
    <trigger scope="player">
        <filter>
            <pulse duration="1s" period="5s" filter="tower-region" />
        </filter>
        <action>
            <kit force="false" filter="always" deduct-items="true">
                <item material="bow" />
                <item material="arrow" amount="1"/>
            </kit>
        </action>
    </trigger>

    <!-- Remove bow and arrows when the player gets out of 'tower region' --> 
    <trigger scope="player" filter="not(tower-region)">
        <action>
            <replace-item ignore-metadata="true">
                <find material="bow"/>
                <replace material="air"/>
            </replace-item>
            <replace-item ignore-metadata="true">
                <find material="arrow"/>
                <replace material="air"/>
            </replace-item>
        </action>
    </trigger>
</actions>

<respawns auto="true">
    <respawn filter="all(team-one-4s,team-one,game_state=${carry})" delay="4s"/> <!-- ??? -->
    <respawn filter="all(team-one-3s,team-one,game_state=${carry})" delay="3.5s"/> <!-- ??? -->
    <respawn filter="all(team-two-4s,team-two,game_state=${carry})" delay="4s"/> <!-- ??? -->
    <respawn filter="all(team-two-3s,team-two,game_state=${carry})" delay="3.5s"/> <!-- ??? -->
    <respawn delay="3s"/>
</respawns>
</map>
