            <cuboid min="248,0,8" max="252,7,11"/> <!-- West Side Bush -->
            <cuboid min="309,0,8" max="313,7,11"/> <!-- East Side Bush -->
            <cuboid min="263,0,8" max="271,7,11"/> <!-- West Front Bush -->
            <cuboid min="290,0,8" max="298,7,11"/> <!-- East Front Bush -->
