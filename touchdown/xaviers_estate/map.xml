<map proto="1.5.1">
<name>Xavier's Estate</name>
<version>1.0.1</version>
<phase>development</phase>
<created>2026-11-09</created>
<constants>
    <constant id="team-flag-posts">true</constant>
    <constant id="team-size">20</constant>
    <constant id="team-one-name">X-Academy</constant>
    <constant id="team-two-name">Brotherhood</constant>
    <constant id="team-one-color">blue</constant>
    <constant id="team-two-color">red</constant>
    <constant id="team-one-spawn">-94.5,24,0.5</constant>
    <constant id="team-one-yaw">-90</constant>
    <constant id="team-two-spawn">95.5,24,0.5</constant>
    <constant id="team-two-yaw">90</constant>
    <constant id="flag-post">0.5,26,0.5</constant>
    <constant id="team-one-flag-post">-62.5,21,0.5</constant>
    <constant id="team-two-flag-post">63.5,21,0.5</constant>
    <constant id="flag-yaw">90</constant>
    <constant id="flag-color">yellow</constant>
    <constant id="time-limit">12m</constant>
    <constant id="indicator-outer-material" delete="true"/>
    <constant id="armor-kit">xe-armor-kit</constant>
    <constant id="flag-carrier-armor-kit">xe-carrier-armor-kit</constant>
    <constant id="flag-drop-kit">xe-flag-drop-kit</constant>
    <constant id="one-pass-default">1</constant>
</constants>
<include id="touchdown"/>
<authors>
    <author uuid="c25a6f7b-4c42-40da-8cd6-add53f0c84eb"/> <!-- arcadeboss -->
    <author>GrokBot</author>
</authors>
<broadcasts>
    <tip after="40s" every="2m">`eThe yellow strip along the edge of field is a speed zone!`r</tip>
</broadcasts>
<spawns>
    <default>
        <region yaw="-180" pitch="35">
            <point>0.5,73,0.5</point>
        </region>
    </default>
</spawns>
<timelock>on</timelock>
<world>
    <timeset>18000</timeset>
</world>
<variables>
    <variable id="xe_from_spawn" scope="player" default="0"/>
    <variable id="pity_block" scope="match" default="0"/>
    <variable id="pity_grant" scope="match" default="0"/>
</variables>
<filters>
    <all id="xe-launch-ok"><participating/><variable var="xe_from_spawn">1</variable></all>
    <all id="xe-on-pad"><participating/><region id="xe-spawn-pads"/></all>
    <all id="xe-in-field"><participating/><region id="xe-field"/></all>
    <all id="xe-platform-side"><region id="xe-platform-band"/></all>
    <deny id="xe-wrong-way"><filter id="xe-platform-side"/></deny>
    <all id="xe-lane-speed"><participating/><alive/><region id="xe-speed-lanes"/></all>
    <all id="xe-blue-td"><team>team-one</team><region id="team-two-portal"/><variable var="can_score">1</variable><variable var="player_state">${carry}</variable><not><flag-carried>flag</flag-carried></not><match-running/><alive/></all>
    <all id="xe-red-td"><team>team-two</team><region id="team-one-portal"/><variable var="can_score">1</variable><variable var="player_state">${carry}</variable><not><flag-carried>flag</flag-carried></not><match-running/><alive/></all>
    <any id="xe-blue-behind">
        <all><score team="team-one">0</score><score team="team-two">[1,oo)</score></all>
        <all><score team="team-one">1</score><score team="team-two">[2,oo)</score></all>
        <all><score team="team-one">2</score><score team="team-two">[3,oo)</score></all>
        <all><score team="team-one">3</score><score team="team-two">[4,oo)</score></all>
        <all><score team="team-one">4</score><score team="team-two">[5,oo)</score></all>
        <all><score team="team-one">5</score><score team="team-two">[6,oo)</score></all>
        <all><score team="team-one">6</score><score team="team-two">[7,oo)</score></all>
    </any>
    <any id="xe-red-behind">
        <all><score team="team-two">0</score><score team="team-one">[1,oo)</score></all>
        <all><score team="team-two">1</score><score team="team-one">[2,oo)</score></all>
        <all><score team="team-two">2</score><score team="team-one">[3,oo)</score></all>
        <all><score team="team-two">3</score><score team="team-one">[4,oo)</score></all>
        <all><score team="team-two">4</score><score team="team-one">[5,oo)</score></all>
        <all><score team="team-two">5</score><score team="team-one">[6,oo)</score></all>
        <all><score team="team-two">6</score><score team="team-one">[7,oo)</score></all>
    </any>
    <all id="xe-pity-blue"><variable var="scoring_team">2</variable><variable var="pity_block">0</variable><filter id="xe-blue-behind"/></all>
    <all id="xe-pity-red"><variable var="scoring_team">1</variable><variable var="pity_block">0</variable><filter id="xe-red-behind"/></all>
</filters>
<kits>
    <kit id="xe-armor-kit">
        <clear items="false" armor="true" effects="false"/>
        <helmet unbreakable="true" team-color="true" locked="true" material="leather helmet"/>
        <chestplate unbreakable="true" locked="true" material="gold chestplate"/>
        <leggings unbreakable="true" locked="true" color="191919" material="leather leggings"/>
        <boots unbreakable="true" team-color="true" locked="true" material="leather boots"/>
    </kit>
    <kit id="xe-carrier-armor-kit">
        <chestplate unbreakable="true" locked="true" name="`b`lJuggernaut's Cuirass" lore="`7Nothing stops the Juggernaut." material="diamond chestplate"/>
        <leggings unbreakable="true" locked="true" name="`b`lJuggernaut's Greaves" lore="`7Nothing stops the Juggernaut." material="diamond leggings"/>
        <boots unbreakable="true" team-color="true" locked="true" material="leather boots"/>
        <action>
            <message text="`6`lYou are the Juggernaut!"/>
        </action>
    </kit>
    <kit id="xe-lane-speed-kit">
        <effect>speed</effect>
    </kit>
    <!-- Mirrors touchdown flag-drop-kit (2026.08.01-2). The post is chosen later in this same capture, so the pity gate has to finish before the kit returns. -->
    <kit id="xe-flag-drop-kit">
        <action filter="alive">
            <action filter="not(player_state=${throw})">
                <replace-item>
                    <find consumable="use-snowball" name="`4`lFootball" material="snowball"/>
                    <replace material="air"/>
                </replace-item>
            </action>
            <kit id="${armor-kit}"/>
            <action id="apply-heal"/>
        </action>
        <action filter="score-prev_score=1..">
            <set var="prev_score" value="score"/>
            <action filter="team-one">
                <set var="scoring_team" value="1"/>
            </action>
            <action filter="team-two">
                <set var="scoring_team" value="2"/>
            </action>
            <action id="increment-round"/>
            <set var="pity_grant" value="3"/>
            <action filter="scoring_team=1">
                <set var="pity_grant" value="2"/>
            </action>
            <action filter="scoring_team=2">
                <set var="pity_grant" value="2"/>
            </action>
            <action filter="xe-pity-blue">
                <set var="pity_grant" value="1"/>
            </action>
            <action filter="xe-pity-red">
                <set var="pity_grant" value="1"/>
            </action>
            <action filter="pity_grant=1">
                <set var="pity_block" value="1"/>
            </action>
            <action filter="pity_grant=2">
                <set var="scoring_team" value="0"/>
                <set var="pity_block" value="0"/>
            </action>
            <action filter="pity_grant=3">
                <set var="scoring_team" value="0"/>
                <set var="pity_block" value="0"/>
            </action>
        </action>
    </kit>
    <lend kit="xe-lane-speed-kit" filter="xe-lane-speed"/>
</kits>
<actions>
    <trigger filter="xe-blue-td" action="increment-round" scope="player"/>
    <trigger filter="xe-red-td" action="increment-round" scope="player"/>
    <trigger filter="xe-on-pad" scope="player">
        <action>
            <set var="xe_from_spawn" value="1"/>
        </action>
    </trigger>
    <trigger filter="xe-in-field" scope="player">
        <action>
            <set var="xe_from_spawn" value="0"/>
        </action>
    </trigger>
</actions>
<regions>
    <cuboid id="playing-field" min="-80,20,-44" max="81,40,45"/>
    <cuboid id="blue-spawn-launch" min="-90,20,-20" max="-80,29,21"/>
    <cuboid id="red-spawn-launch" min="81,20,-20" max="91,29,21"/>
    <cuboid id="team-one-portal" min="-80,20,-44" max="-66,40,45"/>
    <cuboid id="team-two-portal" min="67,20,-44" max="81,40,45"/>
    <union id="play-area">
        <cuboid min="-80,0,-44" max="81,256,45"/>
        <cuboid min="-101,0,-15" max="102,256,16"/>
    </union>
    <union id="xe-speed-lanes">
        <cuboid min="-66,21,42" max="67,25,45"/>
        <cuboid min="-66,21,-44" max="67,25,-41"/>
    </union>
    <cuboid id="xe-field" min="-80,0,-44" max="81,256,45"/>
    <union id="xe-spawn-pads">
        <cuboid min="-102,0,-16" max="-88,256,17"/>
        <cuboid min="89,0,-16" max="103,256,17"/>
    </union>
    <union id="xe-walkback-strip">
        <cuboid min="-88,0,-15" max="-80,256,16"/>
        <cuboid min="81,0,-15" max="89,256,16"/>
    </union>
    <union id="xe-platform-band">
        <cuboid min="-300,0,-300" max="-83,256,300"/>
        <cuboid min="84,0,-300" max="300,256,300"/>
    </union>
    <apply region="play-area" leave="xe-wrong-way" message="`dThe Professor senses you're going the wrong way."/>
    <apply region="play-area" leave="xe-platform-side" message="`dProfessor Xavier compels you to stay on the field!"/>
    <apply region="xe-walkback-strip" enter="xe-launch-ok" message="`dThe Professor senses you're going the wrong way."/>
    <apply region="blue-spawn-launch" velocity="1.5,1.5,0" filter="xe-launch-ok"/>
    <apply region="red-spawn-launch" velocity="-1.5,1.5,0" filter="xe-launch-ok"/>
    <below id="void-plane" y="0"/>
</regions>
</map>
