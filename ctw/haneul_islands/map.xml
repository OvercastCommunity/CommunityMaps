<map proto="1.5.0">
<name>Haneul Islands</name>
<version>1.0.1</version>
<objective>Capture the wool from the enemy team!</objective>
<include id="gapple-kill-reward" />
<authors>
    <author uuid="ca25df12-cc0b-4812-a85b-7aa134561f88" /> <!-- eunsoule -->
</authors>
<contributors>
    <contributor uuid="4d6ecfd1-2e0e-49b6-83c6-e230efe448d4" contribution="Building help" /> <!-- 3lii3 -->
    <contributor uuid="63ddf58a-ba2c-4d39-8481-6358bb46c63a" contribution="Feedback" /> <!-- samschaap -->
</contributors>
<gamemode>ctw</gamemode>
<created>2026-07-14</created>
<teams>
    <team id="green-team" color="green" max="5">Green</team>
    <team id="red-team" color="red" max="5">Red</team>
</teams>
<kits>
    <kit id="player-kit">
        <clear />
        <item slot="0" material="iron sword" unbreakable="true" />
        <item slot="1" material="bow" unbreakable="true" />
        <item slot="2" material="iron pickaxe" unbreakable="true" />
        <item slot="3" material="iron axe" unbreakable="true" />
        <item slot="4" material="iron spade" unbreakable="true" />
        <item slot="29" material="shears" unbreakable="true" />
        <item slot="5" material="wood:0" amount="64" />
        <item slot="6" material="vine" amount="16" />
        <item slot="7" material="golden apple" />
        <item slot="8" material="arrow" amount="16" />
        <helmet material="leather helmet" team-color="true" unbreakable="true" />
        <chestplate material="iron chestplate" unbreakable="true" />
        <leggings material="leather leggings" team-color="true" unbreakable="true" />
        <boots material="leather boots" team-color="true" unbreakable="true" />
        <effect amplifier="255" duration="3s">damage resistance</effect>
    </kit>
</kits>
<itemkeep>
    <item>iron sword</item>
    <item>bow</item>
    <item>stone pickaxe</item>
    <item>stone axe</item>
    <item>stone spade</item>
    <item>shears</item>
    <item>wood</item>
    <item>vine</item>
    <item>golden apple</item>
    <item>arrow</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>iron chestplate</item>
    <item>leather leggings</item>
    <item>leather boots</item>
    <item>string</item>
</itemremove>
<item-mods>
    <rule>
        <match>
            <!-- Included in observer spawn -->
            <material>iron sword</material>
            <material>bow</material>
            <material>iron axe</material>
            <material>leather helmet</material>
            <material>iron chestplate</material>
            <material>leather leggings</material>
            <material>leather boots</material>

            <!-- Included in defense supplies -->
            <material>iron pickaxe</material>
            <material>iron spade</material>

            <!-- For wool holders -->
            <material>diamond chestplate</material>
        </match>
        <modify unbreakable="true" />
    </rule>
</item-mods>
<world>
    <randomtime />
    <timelock>off</timelock>
</world>
<maxbuildheight>21</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
<wools>
    <wool team="green-team" color="red" location="-66,9,18" craftable="false">
        <monument>
            <block>39.5,11,-15.5</block>
        </monument>
    </wool>
    <wool team="red-team" color="green" location="67,9,18" craftable="false">
        <monument>
            <block>-38.5,11,-15.5</block>
        </monument>
    </wool>
</wools>
<filters>
    <material id="non-breakable">STAINED_CLAY</material>
    <material id="cobweb">web</material>
</filters>
<regions>
    <!-- Map regions -->
    <cuboid id="obs-spawn-region" min="6,-oo,34" max="-4,oo,45" />
    <point id="obs-spawn">0.5,14,39.5</point>
    
    <negative id="non-placeable-region">
        <union id="placeable-region">
            <cuboid min="32,-oo,-22" max="-31,oo,23" />
            <cuboid min="58,-oo,23" max="-57,oo,12" />
            <region id="obs-spawn-region" />
        </union>
    </negative>
    <below id="void-region" y="1" />

    <!-- Spawn regions -->
    <cuboid id="green-spawn-region" min="32,-oo,-22" max="44,oo,-12" />
    <point id="green-spawn">37.5,10,-16.5</point>

    <cuboid id="red-spawn-region" min="-31,-oo,-22" max="-43,oo,-12" />
    <point id="red-spawn">-36.5,10,-16.5</point>

    <union id="spawn-region">
        <region id="green-spawn-region" />
        <region id="red-spawn-region" />
    </union>

    <!-- Wool regions-->
    <cuboid id="green-wool-spawner" min="67.5,9.2,18.5" max="66.5,9.2,16.5"  />
    <cuboid id="green-wool-region" min="58,-oo,24" max="72,oo,11" />

    <cuboid id="red-wool-spawner" min="-66.5,9.2,18.5" max="-65.5,9.2,16.5" />
    <cuboid id="red-wool-region" min="-57,-oo,24" max="-71,oo,11" />

    <!-- Filters -->
    <apply region="green-wool-region" block-break="all(cobweb, red-team)" message="You may not modify the wool room." />
    <apply region="red-wool-region" block-break="all(cobweb, green-team)" message="You may not modify the wool room." />

    <apply region="spawn-region" block="never" message="You may not modify the spawn room." />

    <apply block="never" message="You may not modify outside the play area." region="non-placeable-region" />
    <apply block="not(non-breakable)" message="You may not modify the bottom of the islands." />

    <apply enter="not(green-team)" message="You may not enter your own wool room." region="green-wool-region" />
    <apply enter="not(red-team)" message="You may not enter your own wool room." region="red-wool-region" />

    <apply enter="green-team" message="You may not enter enemy's spawn." region="green-spawn-region" />
    <apply enter="red-team" message="You may not enter enemy's spawn." region="red-spawn-region" />
</regions>
<spawns>
    <spawn team="green-team" kit="player-kit" region="green-spawn" yaw="90" />
    <spawn team="red-team" kit="player-kit" region="red-spawn" yaw="-90" />
    <default region="obs-spawn" yaw="180" />
</spawns>
<spawners>
    <spawner spawn-region="green-wool-spawner" player-region="green-wool-region" max-entities="5" delay="2s" filter="red-team">
        <item amount="1" material="green wool"/>
    </spawner>
    <spawner spawn-region="red-wool-spawner" player-region="red-wool-region" max-entities="5" delay="2s" filter="green-team">
        <item amount="1" material="red wool"/>
    </spawner>
</spawners>
<kill-rewards>
    <kill-reward>
        <item amount="8" material="arrow" />
        <item amount="16" material="wood:0" />
        <item amount="8" material="vine" />
    </kill-reward>
</kill-rewards>
</map>