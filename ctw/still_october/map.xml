<!--map-->
<map proto="1.5.1">
<name>Still October</name>
<phase>development</phase>
<version>1.0.1</version>
<created>2026-09-15</created>
<objective>You have to capture the wool on the enemy side and place it on your victory monument!</objective>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="9c14b7e9-8488-427a-bc81-7193becde2d3"/> <!-- MrTinyPig -->
</authors>
<!--KITS KITS KITS-->
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="stone sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="2" unbreakable="true" material="iron pickaxe">
            <enchantment>efficiency</enchantment>
        </item>
        <item slot="3" unbreakable="true" material="iron axe">
            <enchantment>efficiency</enchantment>
        </item>
        <item slot="4" material="wood" damage="1" amount="48"/>
        <item slot="5" material="glass" amount="32"/>
        <item slot="7" material="arrow" amount="20"/>
        <item slot="30" material="iron shovel" unbreakable="true"/>
        <item slot="8" material="golden apple"/>
        <!--ARMOR-->
        <helmet material="leather helmet" team-color="true" unbreakable="true"/>
        <chestplate material="leather chestplate" team-color="true" unbreakable="true"/>
        <leggings material="chainmail leggings" unbreakable="true">
            <enchantment level="2">projectile protection</enchantment>
        </leggings>
        <boots material="leather boots" team-color="true" unbreakable="true">
            <enchantment>feather falling</enchantment>
        </boots>
    </kit>
</kits>
<!--STUFF FOR uuh stuff-->
<teams>
    <team id="orange-team" max="8" color="gold">Orange</team>
    <team id="magenta-team" max="8" color="light purple">Magenta</team>
</teams>
<!--spawns-->
<spawns>
    <spawn team="orange-team" kit="spawn-kit">
        <region>
            <point>6.5,7,-14.5</point>
        </region>
    </spawn>
    <spawn team="magenta-team" kit="spawn-kit" yaw="180">
        <region>
            <point>90.5,7,137.5</point>
        </region>
    </spawn>
    <default yaw="90">
        <region>
            <point>48.5,31,61.5</point>
        </region>
    </default>
</spawns>
<!--wool monument-->
<wools craftable="false">
    <wool team="magenta-team" color="magenta" location="62.5,8,-12.5">
        <monument>
            <block>93.5,8,129.5</block>
        </monument>
    </wool>
    <wool team="orange-team" color="orange" location="34.5,8,135.5">
        <monument>
            <block>3.5,8,-6.5</block>
        </monument>
    </wool>
</wools>
<!--FILTERS FILTERS FILTERS-->
<filters>
    <all id="iron-renew">
        <material id="only-iron">iron block</material>
        <cause>world</cause>
    </all>
    <deny id="deny-chest">
        <material>chest</material>
    </deny>
</filters>		
<!--REGIONS REGIONS REGIONS-->
<regions>
    <negative id="void-area">
        <union id="gamezone">
            <!--gamezone-->
            <rectangle id="magenta-row" min="57.5,-10.5" max="67.5,128.5"/>
            <rectangle id="front-orange-wool" min="70.5,114.5" max="29.5,128.5"/>
            <rectangle id="orange-row" min="39.5,133.5" max="29.5,-5.5"/>
            <rectangle id="front-magenta-wool" min="26.5,8.5" max="67.5,-5.5"/>
            <rectangle id="middle1" min="39.5,83.5" max="57.5,71.5"/>
            <rectangle id="middle2" min="39.5,39.5" max="57.5,51.5"/>
            <!--important areas-->
            <union id="spawn-areas">
                <rectangle id="magenta-spawn" min="95.5,142.5" max="71.5,113.5"/>
                <rectangle id="orange-spawn" min="1.5,-19.5" max="25.5,9.5"/>
            </union>
            <union id="wool-rooms"> <!--where they can place blocks (so no placement in void-->
                <rectangle id="magenta-wool-room" min="57.5,-21.5" max="67.5,-11.5"/>
                <rectangle id="orange-wool-room" min="39.5,144.5" max="29.5,134.5"/>
            </union>
        </union>
    </negative>
    <!--wool spawner-->
    <point id="orange-wool-spawner">34.5,8.5,139.5</point>
    <point id="magenta-wool-spawner">62.5,8.5,-16.5</point>
    <!--APPLY STUFF IN REGIONS-->
    <apply region="void-area" block="never" message="You may not edit the void!"/>
    <!--deny entrance-->
    <apply region="magenta-spawn" enter="deny(orange-team)" message="You may not enter the enemy spawn!"/>
    <apply region="orange-spawn" enter="deny(magenta-team)" message="You may not enter the enemy spawn!"/>	
    <apply region="orange-wool-room" enter="deny(magenta-team)" message="You may not enter your own wool room!"/>
    <apply region="magenta-wool-room" enter="deny(orange-team)" message="You may not enter your own wool room!"/>
    <apply region="orange-wool-room" block="deny(magenta-team)" message="You may not modify your own wool room!"/>
    <apply region="magenta-wool-room" block="deny(orange-team)" message="You may not modify your own wool room!"/>
    <!--block placement-->
    <apply region="spawn-areas" block-break="only-iron" block-place="iron-renew" message="You may not edit the spawn areas!"/>
    <apply region="wool-rooms" block="deny-chest" message="You may not modify this block!"/>
</regions>
<!--the other important stuff-->
<maxbuildheight>18</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
<itemkeep>
    <item>wood</item>
    <item>glass</item>
    <item>arrow</item>
    <item>golden apple</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>seeds</item>
    <item>string</item>
</itemremove>
<toolrepair>
    <tool>stone sword</tool>
    <tool>iron axe</tool>
    <tool>iron pickaxe</tool>
    <tool>iron shovel</tool>
    <tool>bow</tool>
</toolrepair>
<renewables>
    <renewable rate="2" region="spawn-areas" renew-filter="only-iron"/>
</renewables>
<block-drops>
    <rule filter="only-iron">
        <drops>
            <item material="iron chestplate"/>
        </drops>
    </rule>
</block-drops>
<spawners>
    <spawner spawn-region="orange-wool-spawner" player-region="orange-wool-room" delay="3s" max-entities="5">
        <item material="wool" damage="1" amount="1"/>
    </spawner>
    <spawner spawn-region="magenta-wool-spawner" player-region="magenta-wool-room" delay="3s" max-entities="5">
        <item material="wool" damage="2" amount="1"/>
    </spawner>
</spawners>
<world>
    <timeset>1</timeset>
</world>
<kill-rewards>
    <kill-reward>
        <item material="wood" damage="2" amount="16"/>
        <item material="arrow" amount="8"/>
    </kill-reward>
</kill-rewards>
</map>
