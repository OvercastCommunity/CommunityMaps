<map proto="1.5.1">
<name>803</name>
<version>2.0.2</version>
<gamemode>ctw</gamemode>
<objective>Capture the wool!</objective>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="644521d7-9437-47c1-b1d2-698eb757df3d"/> <!-- minuyo -->
</authors>
<contributors>
    <contributor uuid="fe3608b7-d105-4029-8800-34b3147065b6" contribution="clicking some buttons (XML)"/> <!-- rockymine -->
    <contributor uuid="e2d2c2c6-cea9-4510-9ab2-a091b5605b30" contribution="XML"/> <!-- Ruediger_LP -->
</contributors>
<teams>
    <team id="red-team" color="red" max="16">Red</team>
    <team id="blue-team" color="blue" max="16">Blue</team>
</teams>
<kits>
	<kit id="spawn-kit">
        <clear/>
        <item slot="0" material="iron sword" unbreakable="true"/>
        <item slot="1" material="bow" unbreakable="true">
            <enchantment>arrow infinite</enchantment>
        </item>
        <item slot="2" material="iron pickaxe" unbreakable="true"/>
        <item slot="3" material="iron axe" unbreakable="true"/>
        <item slot="4" material="wood" damage="2" amount="64"/>
        <item slot="5" material="glass" amount="64"/>
        <item slot="6" material="potion" damage="16396"/>
        <item slot="7" material="bucket"/>
        <item slot="8" material="golden apple"/>
        <item slot="28" material="arrow"/>
        <item slot="29" material="shears" unbreakable="true"/>
        <item slot="30" material="iron spade" unbreakable="true"/>
        <item slot="31" material="wood" damage="2" amount="64"/>
        <helmet material="leather helmet" team-color="true" unbreakable="true"/>
        <chestplate material="leather chestplate" team-color="true" unbreakable="true"/>
        <leggings material="chainmail leggings" unbreakable="true"/>
        <boots material="leather boots" team-color="true" unbreakable="true"/>
        <effect duration="oo" amplifier="100">damage resistance</effect>
    </kit>
    <kit id="reset-resistance-kit" force="true">
        <effect duration="0" amplifier="0">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <default yaw="180" region="observer-spawn"/>
    <spawn team="red-team" kit="spawn-kit" yaw="90" region="red-spawn-point"/>
    <spawn team="blue-team" kit="spawn-kit" yaw="-76.2" region="blue-spawn-point"/>
</spawns>
<wools>
    <wool team="blue-team" color="blue" location="65,13,76" monument="blue-blue-monument"/>
    <wool team="red-team" color="red" location="-65,13,-76" monument="red-red-monument"/>
</wools>
<filters>
    <team id="only-blue">blue-team</team>
    <team id="only-red">red-team</team>
    <not id="block-place-void-filter">
        <void/>
    </not>
    <any id="block-break-void-filter">
        <all>
            <any>
                <material>log</material>
                <material>log 2</material>
                <material>leaves</material>
                <material>leaves 2</material>
                <material>long grass</material>
                <material>yellow flower</material>
                <material>red rose</material>
                <material>double plant</material>
                <material>water lily</material>
                <material>vine</material>
            </any>
            <void/>
        </all>
        <filter id="block-place-void-filter"/>
    </any>
    <not id="not-blue">
        <filter id="only-blue"/>
    </not>
    <all id="blues-woolrooms-filter">
        <filter id="not-blue"/>
        <filter id="woolrooms-filter"/>
    </all>
    <not id="not-red">
        <filter id="only-red"/>
    </not>
    <all id="reds-woolrooms-filter">
        <filter id="not-red"/>
        <filter id="woolrooms-filter"/>
    </all>
    <material id="chest-filter">chest</material>
    <any id="woolrooms-filter">
        <material>web</material>
        <material>stained glass</material>
        <material>stained glass pane</material>
        <material>wood</material>
        <material>stained clay</material>
        <all>
            <cause>player</cause>
            <any>
                <material>water</material>
                <material>stationary water</material>
            </any>
        </all>
    </any>
    <material id="only-air">air</material>
    <all id="spawns-block-place-filter">
        <cause>world</cause>
        <any>
            <material>iron block</material>
            <material>stone</material>
            <material>air</material>
            <material>29</material>
            <material>33</material>
            <material>34</material>
            <material>36</material>
        </any>
    </all>
    <any id="spawns-block-break-filter">
        <material id="only-iron">iron block</material>
        <all>
            <cause>world</cause>
            <any>
                <material>stone</material>
                <material>air</material>
                <material>29</material>
                <material>33</material>
                <material>34</material>
                <material>36</material>
            </any>
        </all>
    </any>
    <deny id="deny-redstone">
        <any>
            <material>redstone wire</material>
            <material>redstone lamp on</material>
        </any>
    </deny>
</filters>
<regions>
    <point id="blue-spawn-point">-101.5,9,-24.5</point>
    <point id="red-spawn-point">102.5,9,25.5</point>
    <point id="red-wool-spawn">-64.5,13,-75.5</point>
    <point id="blue-wool-spawn">65.5,13,76.5</point>
    <point id="observer-spawn">0.5,53,75.5</point>
    <block id="blue-red-monument">-91,10,-20</block>
    <block id="red-blue-monument">91,10,20</block>
    <block id="red-red-monument">91,10,20</block>
    <block id="blue-blue-monument">-91,10,-20</block>
    <rectangle id="blue-spawn" min="-111,-32" max="-89,-19"/>
    <rectangle id="red-spawn" min="90,20" max="112,33"/>
    <rectangle id="red-wool" min="-71,-81" max="-58,-66"/>
    <rectangle id="blue-wool" min="59,67" max="72,82"/>
    <union id="reds-woolrooms">
        <region id="blue-wool"/>
    </union>
    <union id="blues-woolrooms">
        <region id="red-wool"/>
    </union>
    <union id="woolrooms">
        <region id="reds-woolrooms"/>
        <region id="blues-woolrooms"/>
    </union>
    <negative id="not-spawns">
        <region id="spawns"/>
    </negative>
    <negative id="not-build-area">
        <union id="build-area">
            <rectangle id="build-area-1" min="-58,-47" max="-32,-32"/>
            <rectangle id="build-area-2" min="33,33" max="59,48"/>
            <rectangle id="build-area-3" min="-32,-47" max="-19,20"/>
            <rectangle id="build-area-4" min="20,-19" max="33,48"/>
            <rectangle id="build-area-5" min="-45,-6" max="-32,7"/>
            <rectangle id="build-area-6" min="33,-6" max="46,7"/>
        </union>
    </negative>
    <complement id="spawns">
        <union id="spawn-areas">
            <region id="red-spawn"/>
            <region id="blue-spawn"/>
        </union>
        <region id="blue-blue-monument"/>
        <region id="red-red-monument"/>
    </complement>
    <apply enter="only-red" region="red-spawn" message="You may not enter the enemy's spawn!"/>
    <apply enter="only-blue" region="blue-spawn" message="You may not enter the enemy's spawn!"/>
    <apply enter="not-red" region="reds-woolrooms" message="You may not enter your own wool room!"/>
    <apply enter="not-blue" region="blues-woolrooms" message="You may not enter your own wool room!"/>
    <apply block-place="spawns-block-place-filter" block-break="spawns-block-break-filter" region="spawns" message="You may not edit spawn!"/>
    <apply block="reds-woolrooms-filter" region="reds-woolrooms" message="You may not edit the wool room!"/>
    <apply block="blues-woolrooms-filter" region="blues-woolrooms" message="You may not edit the wool room!"/>
    <apply block-place="block-place-void-filter" block-break="block-break-void-filter" region="not-build-area" message="You may not edit the void!"/>
    <apply use="deny(all(only-red,chest-filter))" region="reds-woolrooms"/>
    <apply use="deny(all(only-blue,chest-filter))" region="blues-woolrooms"/>
    <apply kit="reset-resistance-kit" region="not-spawns"/>
    <apply block-physics="deny-redstone" region="woolrooms"/>
</regions>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>arrow</tool>
    <tool>shears</tool>
    <tool>iron spade</tool>
</toolrepair>
<itemkeep>
    <item>iron sword</item>
    <item>bow</item>
    <item>iron pickaxe</item>
    <item>iron axe</item>
    <item>arrow</item>
    <item>shears</item>
    <item>iron spade</item>
    <item>wood</item>
    <item>glass</item>
    <item>potion</item>
    <item>bucket</item>
    <item>water bucket</item>
    <item>golden apple</item>
</itemkeep>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>stone</item>
</itemremove>
<block-drops>
	<rule>
		<filter>
			<any>
				<material>wood:2</material>
				<material>glass</material>
			</any>
		</filter>
		<drops>
			<item chance="0" material="wood"/>
		</drops>
	</rule>
</block-drops>
<item-mods>
	<rule>
		<match>
			<material>iron helmet</material>
			<material>iron chestplate</material>
			<material>iron leggings</material>
			<material>iron boots</material>
			<material>iron sword</material>
			<material>iron pickaxe</material>
			<material>iron axe</material>
			<material>iron spade</material>
			<material>shears</material>
			<material>bow</material>
			<material>diamond chestplate</material>
		</match>
		<modify unbreakable="true"/>
	</rule>
</item-mods>
<renewables>
	<renewable rate="1" region="spawns" renew-filter="only-iron" replace-filter="only-air" avoid-players="2"/>
</renewables>
<hunger>
	<depletion>off</depletion>
</hunger>
<maxbuildheight>24</maxbuildheight>
<kill-rewards>
	<kill-reward>
		<item material="wood" damage="2" amount="32"/>
		<item material="glass" amount="16"/>
	</kill-reward>
</kill-rewards>
</map>
