<map proto="1.5.1">
<name>Bricked N Clayed</name>
<gamemode>CTW</gamemode>
<version>1.0.0</version>
<created>2026-09-20</created>
<objective>You have to capture the wool on the enemy side and place it in your victory monument!</objective>
<authors>
	<author uuid="9c14b7e9-8488-427a-bc81-7193becde2d3" contribution="Map Author and XML"/>
	<author uuid="4d6ecfd1-2e0e-49b6-83c6-e230efe448d4" contribution="Mid and wool room"/>
</authors>
<!--kits kits kits-->
<kits>
	<kit id="spawn-kit">
		<item slot="0" unbreakable="true" material="stone sword"/>
		<item slot="1" unbreakable="true" material="bow"/>
		<item slot="2" unbreakable="true" material="iron pickaxe">
			<enchantment level="2">efficiency</enchantment>
		</item>
		<item slot="3" unbreakable="true" material="iron axe">
			<enchantment level="2">efficiency</enchantment>
		</item>
		<item slot="5" material="wood" damage="1" amount="64"/>
		<item slot="6" material="glass" amount="48"/>
		<item slot="7" material="arrow" amount="32"/>
		<item slot="30" material="iron shovel" unbreakable="true">
			<enchantment level="2">efficiency</enchantment>
		</item>
		<item slot="8" material="golden apple"/>
	<!--ARMOR-->
		<helmet material="leather helmet" team-color="true" unbreakable="true"/>
		<chestplate material="leather chestplate" team-color="true" unbreakable="true"/>
		<leggings material="chainmail leggings" unbreakable="true">
			<enchantment level="2">projectile protection</enchantment>
		</leggings>
		<boots material="leather boots" team-color="true" unbreakable="true">
			<enchantment>feather falling</enchantment>
		</boots>
	</kit>
</kits>
<!--teams and spawns-->
<teams>
	<team id="magenta-team" color="light purple" max="24">Magenta</team>
	<team id="orange-team" color="gold" max="24">Orange</team>
</teams>
<spawns>
	<spawn team="magenta-team" kit="spawn-kit" yaw="30">
		<region>
			<point>-3.5,11.1,-135.5</point>
		</region>
	</spawn>
	<spawn team="orange-team" kit="spawn-kit" yaw="-150">
		<region>
			<point>107.5,11.1,94.5</point>
		</region>
	</spawn>
	<default yaw="90">
		<region>
			<point>1.5,23.5,-20.5</point>
		</region>
	</default>
</spawns>
<!--filters-->
<filters>
	<not id="void-area">
		<void/>
	</not>
	<all id="iron-renew">
		<material id="only-iron">iron block</material>
		<cause>world</cause>
	</all>
	<blocks id="only-wool-room" region="wool-rooms">
		<not>
			<any>
				<material>chest</material>
				<material>stained clay:1</material>
				<material>stained clay:2</material>
			</any>
		</not>
	</blocks>
</filters>
<!--regions regions regions-->
<regions>
<!--spawn related stuff-->
	<union id="spawn-areas">
		<cuboid id="magenta-spawn" min="-13.5,0,-144.5" max="15.5,35,-106.5"/>
		<cuboid id="orange-spawn" min="117.5,0,103.5" max="88.5,35,65.5"/>
	</union>
	<apply block-break="only-iron" block-place="iron-renew" region="spawn-areas" message="You may not edit the spawn areas!"/>
	<apply enter="deny(magenta-team)" region="orange-spawn" message="You may not enter the enemy spawn!"/>
	<apply enter="deny(orange-team)" region="magenta-spawn" message="You may not enter the enemy spawn!"/>
<!--void area-->
	<cuboid id="game-area" min="214,69,-325" max="-135,0,299"/>
<!--wool room related stuff-->
	<union id="wool-rooms">
		<cuboid id="magenta-wool-room" min="13.5,0,167.5" max="33.5,35,149.5"/>
		<cuboid id="orange-wool-room" min="90.5,0,-208.5" max="70.5,35,-190.5"/>
	</union>
		<!--no own wool room grief-->
	<apply block="deny(magenta-team)" region="orange-wool-room" message="You may not grief your own wool room!"/>
	<apply block="deny(orange-team)" region="magenta-wool-room" message="You may not grief your own wool room!"/>
	<apply region="wool-rooms" block-break="only-wool-room" message="You may not grief up the wool room!"/>
		<!--apply buildable zone-->
	<apply block="void-area" region="game-area" message="You may not edit the void!"/>
		<!--no enter own wool room-->
	<apply enter="deny(magenta-team)" region="orange-wool-room" message="You may not enter your own wool room!"/>
	<apply enter="deny(orange-team)" region="magenta-wool-room" message="You may not enter your own wool room!"/>
		<!--where spawner spawns stuff-->
	<cuboid id="gapple-detector-3000" min="45.5,8,-23.5" max="58.5,12,-17.5"/>
	<point id="orange-wool-spawner">82,17.5,-205</point>
	<point id="magenta-wool-spawner">22,17.5,164</point>
	<point id="gapple-1">55.5,9.1,-20.5</point>
	<point id="gapple-2">48.5,9.1,-20.5</point>
</regions>
<!--wools-->
<wools>
	<wool craftable="false" team="magenta-team" color="magenta" location="22,17.5,164">
		<monument>
			<block>2.5,11,-126.5</block>
		</monument>
	</wool>
	<wool team="orange-team" color="orange" location="82,17.5,-205">
		<monument>
			<block>101.5,11,85.5</block>
		</monument>
	</wool>
</wools>
<!--gamerules-->
<maxbuildheight>28</maxbuildheight>
<hunger>
	<depletion>off</depletion>
</hunger>
<world>
	<timeset>1</timeset>
</world>
<!--items items items-->
<itemremove>
	<item>leather helmet</item>
	<item>leather chestplate</item>
	<item>chainmail leggings</item>
	<item>leather boots</item>
	<item>glass</item>
</itemremove>
<toolrepair>
	<tool>stone sword</tool>
	<tool>iron axe</tool>
	<tool>iron pickaxe</tool>
	<tool>bow</tool>
</toolrepair>
<renewables>
	<renewable rate="2" region="spawn-areas" renew-filter="only-iron"/>
</renewables>
<spawners>
	<spawner spawn-region="orange-wool-spawner" player-region="orange-wool-room" max-entities="16" delay="4s">
		<item material="wool" damage="1" amount="1"/>
	</spawner>
	<spawner spawn-region="magenta-wool-spawner" player-region="magenta-wool-room" max-entities="16" delay="4s">
		<item material="wool" damage="2" amount="1"/>
	</spawner>
		<!--mid golden apple spawners-->
	<spawner spawn-region="gapple-1" player-region="gapple-detector-3000" max-entities="4">
		<item material="golden apple" amount="1"/>
	</spawner>
	<spawner spawn-region="gapple-2" player-region="gapple-detector-3000" max-entities="4">
		<item material="golden apple" amount="1"/>
	</spawner>
</spawners>
<kill-rewards>
	<kill-reward>
		<item material="golden apple"/>
		<item material="wood" damage="1" amount="32"/>
		<item material="arrow" amount="16"/>
		<item material="glass" amount="16"/>
	</kill-reward>
</kill-rewards>
</map>