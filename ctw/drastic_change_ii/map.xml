<map proto="1.5.1">
<name>Drastic Change II</name>
<version>1.0.1</version>
<objective>Capture the two enemy's wools!</objective>
<created>2026-06-24</created>
<phase>development</phase>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="fe3608b7-d105-4029-8800-34b3147065b6"/> <!-- rockymine -->
</authors>
<contributors>
    <contributor uuid="84d0f14a-1aae-447f-838c-8ac742667d67" contribution="Remastered XML"/> <!-- limefox3054 -->
</contributors>
<teams>
    <team id="red-team" color="dark red" max="16">Red</team>
    <team id="blue-team" color="blue" max="16">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" material="bow" enchantment="infinity"/>
        <item slot="28" material="arrow"/>
        <item slot="2" unbreakable="true" material="iron pickaxe" enchantment="efficiency"/>
        <item slot="29" unbreakable="true" material="shears"/>
        <item slot="3" unbreakable="true" material="iron axe" enchantment="efficiency"/>
        <item slot="30" unbreakable="true" material="iron spade"/>
        <item slot="4" amount="64" damage="2" material="wood"/>
        <item slot="5" amount="32" team-color="true" material="stained clay"/>
        <item slot="7" material="water bucket"/>
        <item slot="8" material="golden apple"/>
        <helmet unbreakable="true" team-color="true" material="leather helmet"/>
        <chestplate unbreakable="true" team-color="true" material="leather chestplate"/>
        <leggings unbreakable="true" material="chainmail leggings" enchantment="projectile protection"/>
        <boots unbreakable="true" team-color="true" material="leather boots"/>
        <effect duration="5s" amplifier="5">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn-kit">
        <region yaw="-90">
            <point>-84,8,0</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="spawn-kit">
        <region yaw="90">
            <point>84,8,0</point>
        </region>
    </spawn>
    <default>
        <region yaw="90">
            <cylinder base="0,28,0" radius="0.5" height="0"/>
        </region>
        <region yaw="-90">
            <cylinder base="0,28,0" radius="0.5" height="0"/>
        </region>
    </default>
</spawns>
<filters>
    <all id="not-materials-cause-world"> <!-- should be used with deny inline filters -->
        <not>
            <any>
                <!-- prevent block destruction caused by water flow -->
                <material>water</material>
                <material>stationary water</material>
                <!-- make iron block renewable in the wool rooms -->
                <material>iron block</material>
            </any>
        </not>
        <cause>world</cause>
    </all>
    <blocks id="wool-room-blocks" region="wool-rooms">
        <any>
            <material id="only-air">air</material>
            <material>stained glass pane</material>
            <material>iron block</material>
            <material>redstone wire</material>
            <material>redstone torch on</material>
        </any>
    </blocks>
    <all id="only-iron-renew">
        <material id="only-iron">iron block</material>
        <cause>world</cause>
    </all>
    <material id="cobweb">web</material>
    <any id="stones">
        <material>stone:0</material>
        <material>stone:5</material>
    </any>
</filters>
<regions>
    <complement id="spawns">
        <union>
            <union id="red-spawn">
                <rectangle min="-89,-8" max="-73,8"/>
                <rectangle min="-73,-6" max="-61,6"/>
            </union>
            <union id="blue-spawn">
                <rectangle min="61,-6" max="73,6"/>
                <rectangle min="73,-8" max="89,8"/>
            </union>
        </union>
        <union id="victory-monuments">
            <block id="red-team-yellow-wool">-75,9,-3</block>
            <block id="red-team-orange-wool">-75,9,2</block>
            <block id="blue-team-lime-wool">74,9,2</block>
            <block id="blue-team-green-wool">74,9,-3</block>
        </union>
    </complement>
    <union id="wool-rooms">
        <union id="red-wool-rooms"> <!-- blue capture, red defend -->
            <complement id="lime-wool-room">
                <cuboid min="-112,0,24" max="-100,32,36"/>
                <half origin="-113,0,26" normal="-1,0,-3"/>
                <half origin="-113,0,34" normal="-1,0,3"/>
            </complement>
            <complement id="green-wool-room">
                <cuboid min="-112,0,-36" max="-100,32,-24"/>
                <half origin="-113,0,-34" normal="-1,0,-3"/>
                <half origin="-113,0,-26" normal="-1,0,3"/>
            </complement>
        </union>
        <union id="blue-wool-rooms"> <!-- red capture, blue defend -->
            <complement id="yellow-wool-room">
                <cuboid min="100,0,-36" max="112,32,-24"/>
                <half origin="113,0,-26" normal="1,0,3"/>
                <half origin="113,0,-34" normal="1,0,-3"/>
            </complement>
            <complement id="orange-wool-room">
                <cuboid min="100,0,24" max="112,32,36"/>
                <half origin="113,0,34" normal="1,0,3"/>
                <half origin="113,0,26" normal="1,0,-3"/>
            </complement>
        </union>
    </union>
    <negative id="restricted-void-area">
        <union> <!-- buildable void area -->
            <rectangle min="-95,-44" max="-53,-36"/>
            <rectangle min="-95,36" max="-53,44"/>
            <rectangle min="53,36" max="95,44"/>
            <rectangle min="53,-44" max="95,-36"/>
            <rectangle min="-35,-38" max="35,-18"/>
            <rectangle min="-29,-6" max="29,6"/>
            <rectangle min="-35,18" max="35,44"/>
            <rectangle min="-61,-16" max="-49,16"/>
            <rectangle min="-23,-18" max="-9,18"/>
            <rectangle min="9,-18" max="23,18"/>
            <rectangle min="49,-16" max="61,16"/>
        </union>
    </negative>
    <union id="wool-spawns">
        <point id="yellow-wool-spawn">108,12,-30</point>
        <point id="orange-wool-spawn">108,12,30</point>
        <point id="lime-wool-spawn">-108,12,30</point>
        <point id="green-wool-spawn">-108,12,-30</point>
    </union>
    <apply use="red-team" region="blue-wool-rooms"/>
    <apply use="blue-team" region="red-wool-rooms"/>
    <apply enter="red-team" region="red-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="blue-team" region="blue-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="red-team" region="blue-wool-rooms" message="You may not enter your team's own wool rooms!"/>
    <apply enter="blue-team" region="red-wool-rooms" message="You may not enter your team's own wool rooms!"/>
    <apply block-place="only-iron-renew" block-break="only-iron" region="spawns" message="You may only break iron blocks in the spawn!"/>
    <apply block="deny(not-materials-cause-world)" region="wool-rooms"/>
    <apply block="deny(blue-team)" region="blue-wool-rooms" message="You may not modify your team's own wool rooms!"/>
    <apply block="deny(red-team)" region="red-wool-rooms" message="You may not modify your team's own wool rooms!"/>
    <apply block="wool-room-blocks" region="wool-rooms" message="You may not modify the wool rooms!"/>
    <apply block-place="deny(void)" block-break="deny(all(void,cobweb))" region="restricted-void-area" message="You may not modify the void area!"/>
</regions>
<wools craftable="false">
    <wool team="red-team" color="yellow" monument="red-team-yellow-wool" location="108,12,-30"/>
    <wool team="red-team" color="orange" monument="red-team-orange-wool" location="108,12,30"/>
    <wool team="blue-team" color="lime" monument="blue-team-lime-wool" location="-108,12,30"/>
    <wool team="blue-team" color="green" monument="blue-team-green-wool" location="-108,12,-30"/>
</wools>
<spawners>
    <spawner spawn-region="yellow-wool-spawn" player-region="yellow-wool-room" delay="3s" max-entities="8">
        <item amount="2" damage="4" material="wool"/>
    </spawner>
    <spawner spawn-region="orange-wool-spawn" player-region="orange-wool-room" delay="3s" max-entities="8">
        <item amount="2" damage="1" material="wool"/>
    </spawner>
    <spawner spawn-region="lime-wool-spawn" player-region="lime-wool-room" delay="3s" max-entities="8">
        <item amount="2" damage="5" material="wool"/>
    </spawner>
    <spawner spawn-region="green-wool-spawn" player-region="green-wool-room" delay="3s" max-entities="8">
        <item amount="2" damage="13" material="wool"/>
    </spawner>
</spawners>
<renewables>
    <renewable region="spawns" renew-filter="only-iron"/>
    <renewable region="wool-rooms" renew-filter="only-iron" replace-filter="only-air" avoid-players="1"/>
</renewables>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>iron pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
    <tool>shears</tool>
    <tool>arrow</tool>
</toolrepair>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>redstone</item>
    <item>redstone torch on</item>
    <item>sapling</item>
    <item>red rose</item>
    <item>seeds</item>
    <item>long grass</item>
</itemremove>
<itemkeep>
    <item>wood:2</item>
    <item>stained clay:14</item>
    <item>stained clay:11</item>
    <item>water bucket</item>
    <item>bucket</item>
    <item>golden apple</item>
</itemkeep>
<block-drops>
    <rule filter="stones">
        <drops>
            <item material="cobblestone"/>
        </drops>
    </rule>
</block-drops>
<kill-rewards>
    <kill-reward>
        <item amount="16" damage="2" material="wood"/>
        <item amount="8" team-color="true" material="stained clay"/>
    </kill-reward>
</kill-rewards>
<world>
    <timeset>6000</timeset>
</world>
<maxbuildheight>20</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
