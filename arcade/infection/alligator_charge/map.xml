<spawns>
    <default yaw="4" pitch="-11.7">
        <regions>
            <region id="observer"/>
        </regions>
    </default>
    <spawn kit="tutorial-kit" filter="game-tutorial" yaw="-177.6" pitch="2">
        <regions>
            <region id="tutorial-spawn"/>
        </regions>
    </spawn>
    <spawn team="swimmers" kit="swimmer-kit" filter="all(game-running,not(round-running),side-a)" yaw="0" pitch="5">
        <regions>
            <region id="swimmer-start-a"/>
        </regions>
    </spawn>
    <spawn team="swimmers" kit="swimmer-kit" filter="all(game-running,not(round-running),side-b)" yaw="180" pitch="5">
        <regions>
            <region id="swimmer-start-b"/>
        </regions>
    </spawn>
    <spawn team="swimmers" kit="alligator-switch-kit" filter="all(round-running,in-round,drop-single)" yaw="90" pitch="90">
        <regions>
            <region id="alligator-drop"/>
        </regions>
    </spawn>
    <spawn team="swimmers" kit="alligator-switch-kit" filter="all(round-running,in-round,drop-twin)" yaw="90" pitch="90">
        <regions>
            <region id="alligator-drop-west"/>
            <region id="alligator-drop-east"/>
        </regions>
    </spawn>
    <spawn team="swimmers" kit="swimmer-kit" filter="all(round-running,not(in-round))" yaw="0" pitch="5">
        <regions>
            <region id="glass-land"/>
        </regions>
    </spawn>
    <spawn team="alligators" kit="alligator-kit" filter="all(game-running,drop-single)" yaw="90" pitch="90">
        <regions>
            <region id="alligator-drop"/>
        </regions>
    </spawn>
    <spawn team="alligators" kit="alligator-kit" filter="all(game-running,drop-twin)" yaw="90" pitch="90">
        <regions>
            <region id="alligator-drop-west"/>
            <region id="alligator-drop-east"/>
        </regions>
    </spawn>
</spawns>
<variables scope="match">
    <variable id="alligators_amount" default="1"/>
    <variable id="game_state"/>
    <variable id="round_state"/>
    <variable id="current_round"/>
    <variable id="current_message"/>
    <variable id="tmp_pick_min"/>
    <variable id="glass_up"/>
    <variable id="side_a" default="1"/>
    <variable id="drop_twin" default="0"/>
    <variable id="swimmer_rank" default="5"/>
    <variable id="alligator_rank" default="9"/>
    <variable id="no_tag_rounds"/>
    <variable id="tagged_this_round"/>
    <variable id="gator_count"/>
    <variable id="swimmer_count"/>
    <variable id="alive_count"/>
    <variable id="ratio_40"/>
    <variable id="ratio_60"/>
    <variable id="ratio_80"/>
</variables>
<variables scope="player">
    <variable id="is_alligator"/>
    <variable id="tmp_pick"/>
    <variable id="in_pool"/>
    <variable id="finished"/>
    <variable id="stall_warned"/>
    <variable id="stall_nagging"/>
    <variable id="drop_west"/>
    <variable id="in_round"/>
</variables>
<filters>
    <all id="game-tutorial">
        <variable var="game_state">${GAME_TUTORIAL}</variable>
        <match-running/>
    </all>
    <all id="game-running">
        <variable var="game_state">${GAME_RUNNING}</variable>
        <match-running/>
    </all>
    <all id="round-preparing">
        <variable var="round_state">${ROUND_PREPARING}</variable>
        <match-running/>
    </all>
    <all id="round-starting">
        <variable var="round_state">${ROUND_STARTING}</variable>
        <match-running/>
    </all>
    <all id="round-running">
        <variable var="round_state">${ROUND_RUNNING}</variable>
        <match-running/>
    </all>
    <all id="round-finished">
        <variable var="round_state">${ROUND_FINISHED}</variable>
        <match-running/>
    </all>
    <variable id="side-a" var="side_a">1</variable>
    <variable id="side-b" var="side_a">0</variable>
    <variable id="drop-single" var="drop_twin">0</variable>
    <variable id="drop-twin" var="drop_twin">1</variable>
    <variable id="drop-west" var="drop_west">1</variable>
    <variable id="drop-east" var="drop_west">0</variable>
    <variable id="in-round" var="in_round">1</variable>
    <variable id="no-tag-2" var="no_tag_rounds">[2,oo)</variable>
    <variable id="no-tag-3" var="no_tag_rounds">[3,oo)</variable>
    <variable id="ratio-40" var="ratio_40">[0,oo)</variable>
    <variable id="ratio-60" var="ratio_60">[0,oo)</variable>
    <variable id="ratio-80" var="ratio_80">[0,oo)</variable>
    <after id="stall-now" duration="25s" filter="round-running"/>
    <any id="on-stall-pad">
        <all>
            <filter id="side-a"/>
            <region id="poison-a"/>
        </all>
        <all>
            <filter id="side-b"/>
            <region id="poison-b"/>
        </all>
    </any>
    <after id="wait-filter" duration="0.05s">
        <player>
            <team>alligators</team>
        </player>
    </after>
    <players id="swimmers-racing" min="1">
        <all>
            <team>swimmers</team>
            <alive/>
            <variable var="finished">0</variable>
        </all>
    </players>
    <players id="swimmers-jailed" min="1">
        <all>
            <team>swimmers</team>
            <alive/>
            <variable var="finished">1</variable>
        </all>
    </players>
    <players id="enough-for-gators" min="2">
        <all>
            <participating/>
            <alive/>
        </all>
    </players>
    <players id="one-gator" min="1" max="1">
        <all>
            <team>alligators</team>
            <participating/>
            <alive/>
        </all>
    </players>
    <all id="round-all-jailed">
        <filter id="round-running"/>
        <not>
            <filter id="swimmers-racing"/>
        </not>
        <filter id="swimmers-jailed"/>
    </all>
</filters>
<actions>
    <trigger scope="match" filter="match-started" action="game_state:=${GAME_TUTORIAL}"/>
    <action id="set-game-running" scope="match">
        <set var="game_state" value="${GAME_RUNNING}"/>
        <fill region="bars-all" material="iron fence" events="false"/>
    </action>
    <action id="set-round-preparing" scope="match">
        <set var="round_state" value="${ROUND_PREPARING}"/>
    </action>
    <action id="set-round-starting" scope="match">
        <set var="round_state" value="${ROUND_STARTING}"/>
    </action>
    <action id="set-round-running" scope="match">
        <set var="round_state" value="${ROUND_RUNNING}"/>
    </action>
    <action id="set-round-finished" scope="match">
        <set var="round_state" value="${ROUND_FINISHED}"/>
        <sound preset="custom"/>
        <message text="`eNext round is starting!"/>
    </action>
    <action id="welcome-firework" scope="match">
        <sound preset="objective fireworks twinkle"/>
    </action>
    <action id="match-firework" scope="match">
        <sound preset="objective fireworks far"/>
    </action>
    <action id="set-ranks" scope="match">
        <set var="gator_count" value="0"/>
        <set var="swimmer_count" value="0"/>
        <switch-scope inner="player" filter="all(participating,alive,alligators)">
            <set var="gator_count" value="gator_count + 1"/>
        </switch-scope>
        <switch-scope inner="player" filter="all(participating,alive,swimmers)">
            <set var="swimmer_count" value="swimmer_count + 1"/>
        </switch-scope>
        <set var="alive_count" value="gator_count + swimmer_count"/>
        <set var="alligator_rank" value="${ALLIGATOR_SPEED}"/>
        <set var="swimmer_rank" value="${SWIMMER_SPEED}"/>
        <action filter="current_round=1">
            <set var="alligator_rank" value="alligator_rank + 1"/>
        </action>
        <action filter="one-gator">
            <action filter="no-tag-2">
                <set var="alligator_rank" value="alligator_rank - 1"/>
            </action>
            <action filter="no-tag-3">
                <set var="alligator_rank" value="alligator_rank - 1"/>
            </action>
        </action>
        <action filter="not(alive_count=0)">
            <set var="ratio_40" value="gator_count * 5 - alive_count * 2"/>
            <set var="ratio_60" value="gator_count * 5 - alive_count * 3"/>
            <set var="ratio_80" value="gator_count * 5 - alive_count * 4"/>
            <action filter="ratio-40">
                <set var="alligator_rank" value="alligator_rank + 1"/>
            </action>
            <action filter="ratio-60">
                <set var="swimmer_rank" value="swimmer_rank - 1"/>
            </action>
            <action filter="ratio-80">
                <set var="swimmer_rank" value="swimmer_rank - 1"/>
            </action>
        </action>
        <set var="alligator_rank" value="min(10, max(1, alligator_rank))"/>
        <set var="swimmer_rank" value="min(16, max(1, swimmer_rank))"/>
    </action>
    <action id="apply-my-swim-rank" scope="player">
        <kit id="swim-clear-slow"/>
        <action filter="all(swimmers,swimmer_rank=1)">
            <kit id="swimmer-rank-1"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=2)">
            <kit id="swimmer-rank-2"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=3)">
            <kit id="swimmer-rank-3"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=4)">
            <kit id="swimmer-rank-4"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=5)">
            <kit id="swimmer-rank-5"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=6)">
            <kit id="swimmer-rank-6"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=7)">
            <kit id="swimmer-rank-7"/>
        </action>
        <action filter="all(swimmers,swimmer_rank=8)">
