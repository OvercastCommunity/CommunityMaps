            <kit id="swimmer-rank-16"/>
        </action>
        <action filter="all(alligators,alligator_rank=1)">
            <kit id="swim-rank-1"/>
        </action>
        <action filter="all(alligators,alligator_rank=2)">
            <kit id="swim-rank-2"/>
        </action>
        <action filter="all(alligators,alligator_rank=3)">
