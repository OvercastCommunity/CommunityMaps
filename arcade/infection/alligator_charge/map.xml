            <kit id="swim-rank-10"/>
        </action>
    </action>
    <action id="apply-swim-ranks" scope="match">
        <switch-scope inner="player" filter="all(participating,alive)">
            <action id="apply-my-swim-rank"/>
        </switch-scope>
    </action>
    <action id="pick-alligators" scope="match">
        <switch-scope inner="player" filter="participating">
            <set var="is_alligator" value="0"/>
        </switch-scope>
        <switch-scope inner="player" filter="all(participating,swimmers,alive)">
            <set var="tmp_pick" value="random()"/>
        </switch-scope>
        <repeat times="alligators_amount">
            <set var="tmp_pick_min" value="99"/>
            <switch-scope inner="player" filter="all(participating,swimmers,alive)">
                <set var="tmp_pick_min" value="min(tmp_pick, tmp_pick_min)"/>
            </switch-scope>
            <switch-scope inner="player" filter="all(participating,swimmers,alive)">
                <set var="tmp_pick" value="tmp_pick - tmp_pick_min"/>
                <action filter="tmp_pick=0">
                    <set var="tmp_pick" value="99"/>
                    <set var="is_alligator" value="1"/>
                </action>
            </switch-scope>
        </repeat>
        <switch-scope inner="player" filter="all(swimmers,alive,is_alligator=1)">
            <kit id="alligator-switch-kit"/>
            <kit id="alligator-kit"/>
        </switch-scope>
    </action>
    <trigger scope="match" action="current_message:=1">
        <filter>
            <after duration="2s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" action="current_message:=2">
        <filter>
            <after duration="6s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" action="current_message:=3">
        <filter>
            <after duration="9s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" action="current_message:=4">
        <filter>
            <after duration="13s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" action="current_message:=5">
        <filter>
            <after duration="16s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" action="set-game-running">
        <filter>
            <after duration="20s" filter="game-tutorial"/>
        </filter>
    </trigger>
    <trigger scope="match" filter="all(game-tutorial,not(current_message=0))">
        <action>
            <sound key="random.click"/>
            <message text="{text}">
                <replacements>
                    <switch id="text" value="current_message">
                        <case match="1" result="`eWelcome to `a`lAlligator Charge`r`e, a Summertime pool game!"/>
                        <case match="2" result="`a`lAlligators`r, try to tag `c`lSwimmers`r as they cross the pool."/>
                        <case match="3" result="`c`lSwimmers`r, try to cross and exit the pool while avoiding `a`lAlligators`r."/>
                        <case match="4" result="When `c`lSwimmers`r are tagged, they become `a`lAlligators`r."/>
                        <case match="5" result="`eGet Ready to `aCharge`e!"/>
                    </switch>
                </replacements>
            </message>
            <action filter="current_message=1">
                <sound preset="objective fireworks twinkle"/>
                <message fade-in="0.0s" stay="2.5s" fade-out="0.6s" title="`a`lAlligator Charge" subtitle="`eA Summertime pool game"/>
                <schedule after="0.6s">
                    <action id="welcome-firework"/>
                </schedule>
                <schedule after="1.0s">
                    <action id="welcome-firework"/>
                </schedule>
            </action>
            <action filter="current_message=5">
                <message fade-in="0.0s" stay="1.0s" fade-out="1.2s" title="`eGet Ready to `aCharge`e!"/>
            </action>
            <set var="current_message" value="0"/>
        </action>
    </trigger>
    <trigger scope="match" filter="game-running" action="round_state:=${ROUND_PREPARING}"/>
    <trigger scope="match" filter="round-preparing">
        <action>
            <action filter="current_round=0">
                <action filter="enough-for-gators">
                    <action id="pick-alligators"/>
                </action>
            </action>
            <action filter="not(current_round=0)">
                <set var="side_a" value="1-side_a"/>
                <action filter="all(tagged_this_round=0,one-gator)">
                    <set var="no_tag_rounds" value="no_tag_rounds + 1"/>
                </action>
            </action>
            <set var="current_round" value="current_round + 1"/>
            <set var="glass_up" value="0"/>
            <set var="tagged_this_round" value="0"/>
            <fill region="glass-box" material="air" events="false"/>
            <switch-scope inner="player" filter="participating">
                <set var="in_pool" value="0"/>
                <set var="finished" value="0"/>
                <set var="stall_warned" value="0"/>
                <set var="stall_nagging" value="0"/>
                <set var="in_round" value="1"/>
            </switch-scope>
            <action filter="one-gator">
                <set var="drop_twin" value="0"/>
            </action>
            <action filter="not(one-gator)">
                <set var="drop_twin" value="floor(random() * 2)"/>
            </action>
            <switch-scope inner="player" filter="all(alligators,alive)">
                <set var="drop_west" value="floor(random() * 2)"/>
            </switch-scope>
            <action id="set-ranks"/>
            <switch-scope inner="player" filter="all(swimmers,alive)">
                <kit id="swimmer-kit"/>
            </switch-scope>
            <switch-scope inner="player" filter="all(alligators,alive)">
                <kit id="alligator-kit"/>
            </switch-scope>
            <action id="apply-swim-ranks"/>
            <switch-scope inner="player" filter="alive">
                <sound preset="portal"/>
            </switch-scope>
            <action id="set-round-starting"/>
        </action>
    </trigger>
    <trigger scope="match" filter="round-starting">
        <action>
            <sound preset="custom" pitch="2"/>
            <schedule after="0.4s">
                <action id="match-firework"/>
            </schedule>
            <schedule after="0.8s">
                <action id="match-firework"/>
            </schedule>
            <schedule after="1.4s">
                <action id="welcome-firework"/>
            </schedule>
            <action filter="current_round=1">
                <message fade-in="0.0s" stay="1.0s" fade-out="0.4s" title="`a`lCharge!" text="`a`lCharge!"/>
            </action>
            <action filter="not(current_round=1)">
                <message fade-in="0.0s" stay="1.0s" fade-out="0.4s" title="`a`lCharge!" text="`a    `lCharge!"/>
            </action>
        </action>
    </trigger>
    <trigger scope="match">
        <filter>
            <after duration="1s" filter="round-starting"/>
        </filter>
        <action>
            <sound preset="custom" pitch="2"/>
            <switch-scope inner="player" filter="alligators">
                <message fade-in="0.0s" stay="2.0s" fade-out="0.4s" title="Round {na}" subtitle="Tag the Swimmers" text="`a`lRound {na}`r`e has started!">
                    <replacements>
                        <decimal id="na" value="current_round"/>
                    </replacements>
                </message>
            </switch-scope>
            <switch-scope inner="player" filter="not(alligators)">
                <message fade-in="0.0s" stay="2.0s" fade-out="0.4s" title="Round {ns}" subtitle="{hint}" text="`a`lRound {ns}`r`e has started!">
                    <replacements>
                        <decimal id="ns" value="current_round"/>
                        <switch id="hint" value="gator_count">
                            <case match="1" result="Swim past the Alligator"/>
                            <fallback>Swim past the Alligators</fallback>
                        </switch>
                    </replacements>
                </message>
            </switch-scope>
        </action>
    </trigger>
    <trigger scope="match" action="set-round-running">
        <filter>
            <after duration="3s" filter="round-starting"/>
        </filter>
    </trigger>
    <trigger scope="match" action="set-round-finished">
        <filter>
            <after duration="1.5s" filter="round-all-jailed"/>
        </filter>
    </trigger>
    <trigger scope="match">
        <filter>
            <after duration="3s" filter="round-finished"/>
        </filter>
        <action>
            <sound preset="custom"/>
            <message fade-in="0.0s" stay="1.0s" fade-out="0.4s" title="`e3" text="`e    `l3`r`e..."/>
        </action>
    </trigger>
    <trigger scope="match">
        <filter>
            <after duration="4s" filter="round-finished"/>
        </filter>
        <action>
            <sound preset="custom"/>
            <message fade-in="0.0s" stay="1.0s" fade-out="0.4s" title="`e2" text="`e    `l2`r`e..."/>
        </action>
    </trigger>
    <trigger scope="match">
        <filter>
            <after duration="5s" filter="round-finished"/>
        </filter>
        <action>
            <sound preset="custom"/>
            <message fade-in="0.0s" stay="1.0s" fade-out="0.4s" title="`e1" text="`e    `l1`r`e..."/>
        </action>
    </trigger>
    <trigger scope="match" action="set-round-preparing">
        <filter>
            <after duration="6s" filter="round-finished"/>
        </filter>
    </trigger>
    <action id="stall-nag-a" scope="player">
        <action filter="all(round-running,swimmers,alive,on-stall-pad,finished=0)">
            <set var="stall_nagging" value="1"/>
            <sound preset="custom"/>
            <message text="`c`lJump in`r`c and `lswim`r`c!"/>
            <kit>
                <effect amplifier="0" duration="0.5s">wither</effect>
            </kit>
            <schedule after="2s">
                <action id="stall-nag-b"/>
            </schedule>
        </action>
        <action filter="not(all(round-running,swimmers,alive,on-stall-pad,finished=0))">
            <set var="stall_nagging" value="0"/>
        </action>
    </action>
    <action id="stall-nag-b" scope="player">
        <action filter="all(round-running,swimmers,alive,on-stall-pad,finished=0)">
            <set var="stall_nagging" value="1"/>
            <sound preset="custom"/>
            <message text="`c`lJump in`r`c and `lswim`r`c!"/>
            <kit>
                <effect amplifier="0" duration="0.5s">wither</effect>
            </kit>
            <schedule after="2s">
                <action id="stall-nag-a"/>
            </schedule>
        </action>
        <action filter="not(all(round-running,swimmers,alive,on-stall-pad,finished=0))">
            <set var="stall_nagging" value="0"/>
        </action>
    </action>
    <trigger scope="player">
        <filter>
            <all>
                <after duration="18s" filter="round-running"/>
                <team>swimmers</team>
                <alive/>
                <filter id="on-stall-pad"/>
                <variable var="finished">0</variable>
                <variable var="stall_warned">0</variable>
            </all>
        </filter>
        <action>
            <set var="stall_warned" value="1"/>
            <set var="stall_nagging" value="1"/>
            <sound preset="custom"/>
            <sound preset="objective mode"/>
            <message text="`e`lNo stalling`r`e, `nswim`r`e or `ndie`r`e!"/>
            <schedule after="7s">
                <action id="stall-nag-a"/>
            </schedule>
        </action>
    </trigger>
    <trigger scope="player" action="stall-nag-a">
        <filter>
            <all>
                <filter id="stall-now"/>
                <team>swimmers</team>
                <alive/>
                <filter id="on-stall-pad"/>
                <variable var="finished">0</variable>
                <variable var="stall_nagging">0</variable>
            </all>
        </filter>
    </trigger>
    <trigger scope="player" filter="all(round-running,swimmers,alive,in-water,finished=0)">
        <action>
            <set var="in_pool" value="1"/>
            <kit id="pool-heal"/>
        </action>
    </trigger>
    <trigger scope="player" filter="all(round-running,swimmers,alive,finished=0,not(on-stall-pad))">
        <action>
            <set var="in_pool" value="1"/>
        </action>
    </trigger>
    <trigger scope="player" filter="all(round-running,alligators,is_alligator=0)">
        <action>
            <set var="is_alligator" value="1"/>
            <switch-scope inner="match">
                <set var="tagged_this_round" value="1"/>
                <set var="no_tag_rounds" value="0"/>
            </switch-scope>
        </action>
    </trigger>
    <trigger scope="player" filter="all(game-running,alive)">
        <action>
            <schedule after="0.1s">
                <action id="apply-my-swim-rank"/>
            </schedule>
        </action>
    </trigger>
    <trigger scope="player" filter="not(participating)" action="in_round:=0"/>
    <action id="jail-late-join" scope="player">
        <set var="finished" value="1"/>
        <set var="in_pool" value="0"/>
        <sound key="random.click"/>
        <message text="`eWait here for the next round."/>
        <switch-scope inner="match">
            <action filter="glass_up=0">
                <fill region="glass-box" material="glass" events="false"/>
                <fill region="glass-box-air" material="air" events="false"/>
                <set var="glass_up" value="1"/>
            </action>
        </switch-scope>
        <teleport region="glass-land"/>
    </action>
    <trigger scope="player" action="jail-late-join">
        <filter>
            <all>
                <filter id="round-running"/>
                <team>swimmers</team>
                <alive/>
                <not>
                    <filter id="in-round"/>
                </not>
                <variable var="finished">0</variable>
            </all>
        </filter>
    </trigger>
    <action id="finish-swimmer" scope="player">
        <set var="finished" value="1"/>
        <set var="in_pool" value="0"/>
        <message text="`a`lYou made it!`r  `eWait here for the next round."/>
        <switch-scope inner="match">
            <action filter="glass_up=0">
                <fill region="glass-box" material="glass" events="false"/>
                <fill region="glass-box-air" material="air" events="false"/>
                <set var="glass_up" value="1"/>
            </action>
        </switch-scope>
        <sound preset="portal"/>
        <switch-scope inner="match">
            <sound preset="objective fireworks twinkle"/>
        </switch-scope>
        <teleport region="glass-land"/>
    </action>
    <trigger scope="player" action="finish-swimmer">
        <filter>
            <all>
                <filter id="round-running"/>
                <team>swimmers</team>
                <alive/>
                <filter id="side-a"/>
                <region id="finish-a"/>
            </all>
        </filter>
    </trigger>
    <trigger scope="player" action="finish-swimmer">
        <filter>
            <all>
                <filter id="round-running"/>
                <team>swimmers</team>
                <alive/>
                <filter id="side-b"/>
                <region id="finish-b"/>
            </all>
        </filter>
    </trigger>
</actions>
<regions>
    <point id="observer">8.5,51,-39.5</point>
    <point id="tutorial-spawn">-12.5,39,45.5</point>
    <point id="alligator-drop">0.5,52,0.5</point>
    <point id="alligator-drop-west">-13.5,52,0.5</point>
    <point id="alligator-drop-east">14.5,52,0.5</point>
    <cuboid id="swimmer-start-a" min="-18,38,-25" max="19,39,-24"/>
    <cuboid id="swimmer-start-b" min="-18,38,25" max="19,39,26"/>
    <below id="tutorial-void" y="28"/>
    <negative id="in-water">
        <above y="38"/>
    </negative>
    <above id="swimmer-ceiling" y="42"/>
    <above id="finish-a" z="20"/>
    <below id="finish-b" z="-19"/>
    <intersect id="between-bars">
        <above x="-22"/>
        <below x="23"/>
    </intersect>
    <intersect id="poison-a">
        <above y="38"/>
        <below z="-13"/>
        <region id="between-bars"/>
    </intersect>
    <intersect id="poison-b">
        <above y="38"/>
        <above z="14"/>
        <region id="between-bars"/>
    </intersect>
    <intersect id="no-return-a">
        <above y="38"/>
        <below z="-18"/>
        <region id="between-bars"/>
    </intersect>
    <intersect id="no-return-b">
        <above y="38"/>
        <above z="19"/>
        <region id="between-bars"/>
    </intersect>
    <rectangle id="drop-column" min="-4,-4" max="5,5"/>
    <rectangle id="drop-column-west" min="-18,-4" max="-9,5"/>
    <rectangle id="drop-column-east" min="10,-4" max="19,5"/>
    <union id="alligator-ok">
        <intersect>
            <region id="in-water"/>
            <region id="between-bars"/>
        </intersect>
        <region id="drop-column"/>
    </union>
    <union id="alligator-ok-twin">
        <intersect>
            <region id="in-water"/>
            <region id="between-bars"/>
        </intersect>
        <region id="drop-column-west"/>
        <region id="drop-column-east"/>
    </union>
    <cuboid id="bars-east" min="22,38,-25" max="24,42,26"/>
    <cuboid id="bars-west" min="-23,38,-25" max="-21,42,26"/>
    <cuboid id="bars-door" min="-13,39,26" max="-10,40,27"/>
    <union id="bars-all">
        <region id="bars-east"/>
        <region id="bars-west"/>
        <region id="bars-door"/>
    </union>
    <cuboid id="glass-box" min="-10,55,-10" max="10,60,10"/>
    <cuboid id="glass-box-air" min="-9,56,-9" max="9,59,9"/>
    <cuboid id="glass-land" min="-5,58,-5" max="5,59,5"/>
    <complement id="swimmer-no-climb">
        <region id="swimmer-ceiling"/>
        <region id="glass-box"/>
    </complement>
    <apply region="swimmer-no-climb" enter="not(all(round-running,swimmers))" message="Stay in the pool!"/>
    <apply region="alligator-ok" leave="not(all(game-running,alligators,drop-single))" message="Stay in the pool!"/>
    <apply region="alligator-ok-twin" leave="not(all(game-running,alligators,drop-twin))" message="Stay in the pool!"/>
    <apply region="no-return-a" enter="not(all(side-a,swimmers,in_pool=1))" message="No going back!"/>
    <apply region="no-return-b" enter="not(all(side-b,swimmers,in_pool=1))" message="No going back!"/>
    <apply block="never"/>
</regions>
<portals>
    <portal filter="game-tutorial" region="tutorial-void" destination="tutorial-spawn" yaw="@-177.6" pitch="@2" sound="false"/>
    <portal forward="all(round-starting,swimmers,side-a)" destination="swimmer-start-a" yaw="@0" pitch="@5" sound="false"/>
    <portal forward="all(round-starting,swimmers,side-b)" destination="swimmer-start-b" yaw="@180" pitch="@5" sound="false"/>
    <portal forward="all(round-starting,alligators,drop-single)" destination="alligator-drop" yaw="@90" pitch="@90" sound="false"/>
    <portal forward="all(round-starting,alligators,drop-twin,drop-west)" destination="alligator-drop-west" yaw="@90" pitch="@90" sound="false"/>
    <portal forward="all(round-starting,alligators,drop-twin,drop-east)" destination="alligator-drop-east" yaw="@90" pitch="@90" sound="false"/>
</portals>
<respawns auto="true">
    <respawn delay="0s" filter="swimmers"/>
    <respawn delay="0s" filter="all(alligators,not(wait-filter))"/>
    <respawn delay="2s" filter="all(alligators,wait-filter)"/>
</respawns>
<time result="swimmers">5m</time>
<blitz filter="never" join-filter="always">
    <broadcastLives>false</broadcastLives>
</blitz>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>leather leggings</item>
    <item>leather boots</item>
</itemremove>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
