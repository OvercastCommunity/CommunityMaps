    <variable id="forward_distance" />
    <variable id="side_distance" />
    <variable id="tile_variant" />
    <variable id="difficulty" />
    <variable id="should_go_up" />
    <variable id="y_rng" />
    <variable id="max_checkpoint" />
    <variable id="tiles_to_generate" default="15" />
</variables>
<variables scope="player">
    <array id="checkpoint" size="4" default="-1" />
    <variable id="checkpoints_triggered" />
    <variable id="checkpoint_yaw_index" />
    <variable id="just_lost" />
</variables>
<filters>
    <all id="should-turn">
        <any>
            <variable var="tiles_amount">15</variable>
            <variable scope="match" value="tiles_amount%30">0</variable>
        </any>
        <not><variable var="tiles_amount">0</variable></not>
    </all>
    <all id="should-place-checkpoint">
        <any>
            <variable scope="match" value="tiles_amount%15">0</variable>
        </any>
        <not><variable var="tiles_amount">0</variable></not>
    </all>
</filters>
<actions>
    <trigger scope="match">
        <filter>
            <pulse duration="1s" period="4s" filter="all(always,not(match-running))" />
        </filter>
        <action>
            <action filter="tiles_to_generate=1..">
                <action id="generate" />
                <set var="tiles_to_generate" value="tiles_to_generate - 1" />
            </action>
        </action>
    </trigger>

    <trigger scope="match">
        <filter>
            <pulse period="0.5s" duration="0.3s" filter="match-running" />
        </filter>
        <action>
            <action filter="tiles_to_generate=1..">
                <action id="generate" />
                <set var="tiles_to_generate" value="tiles_to_generate - 1" />
            </action>
        </action>
    </trigger>

    <trigger scope="player">
        <filter>
            <pulse duration="0.1s" period="0.2s" filter="match-running" />
        </filter>
        <action>
            <action filter="all(on-checkpoint,player.y-checkpoint[1]=0.9..)">
                <set var="checkpoints_triggered" value="checkpoints_triggered + 1" />
                <set var="max_checkpoint" value="max(max_checkpoint,checkpoints_triggered)" />
                <set var="checkpoint_yaw_index" value="((checkpoints_triggered - 1) % 8) + 1" />
                <set var="checkpoint" index="0" value="player.x" />
                <set var="checkpoint" index="1" value="player.y" />
                <set var="checkpoint" index="2" value="player.z" />
                <set var="score" value="score + 15" />
                <action filter="any(checkpoint_yaw_index=1,checkpoint_yaw_index=8)">
                    <set var="checkpoint" index="3" value="-90" />
                </action>
                <action filter="any(checkpoint_yaw_index=2,checkpoint_yaw_index=3)">
                    <set var="checkpoint" index="3" value="180" />
                </action>
                <action filter="any(checkpoint_yaw_index=4,checkpoint_yaw_index=5)">
                    <set var="checkpoint" index="3" value="90" />
                </action>
                <action filter="any(checkpoint_yaw_index=6,checkpoint_yaw_index=7)">
                    <set var="checkpoint" index="3" value="0" />
                </action>
                <message text="`e`lCheckpoint!" />
                <sound key="random.levelup" volume="0.5" />
                <action filter="max_checkpoint-checkpoints_triggered=0">
                    <set var="tiles_to_generate" value="tiles_to_generate + 15" />
                    <set var="max_checkpoint" value="max_checkpoint + 1" />
                </action>
            </action>
        </action>
    </trigger>

    <trigger scope="player" filter="all(after-1,dead)" action="just_lost := 1" />
    <trigger scope="player" filter="all(after-1,alive,just_lost=1)">
        <action>
            <set var="just_lost" value="0" />
            <action filter="not(checkpoint[1]=-1)">
                <action id="return-to-checkpoint" />
            </action>
        </action>
    </trigger>

    <action id="return-to-checkpoint" scope="player">
        <action filter="checkpoint[1]=-1">
            <sound key="note.bassattack"/>
            <message text="`c⚠ You haven't reached a checkpoint yet!" />
        </action>
        <action filter="not(checkpoint[1]=-1)">
            <teleport x="checkpoint[0]" y="checkpoint[1]" z="checkpoint[2]" yaw="checkpoint[3]" pitch="0" />
        </action>
    </action>

    <action id="generate" scope="match" expose="true">
        <set var="tiles_amount" value="tiles_amount + 1" />
        <set var="jump_length" value="2 + floor(random() + 0.1 + difficulty * 0.6 / 100)" />
        <set var="forward_distance" value="jump_length + tile_length" />
        <set var="side_distance" value="floor(random() * 3) * (floor(random() * 2) * 2 - 1)" />
        <set var="selected_tile" value="floor(random() * (1 + 8 * difficulty / 100)) + 1" />
        <action filter="should-place-checkpoint">
            <set var="selected_tile" value="${TILE_CHECKPOINT}" />
            <set var="difficulty" value="min(100, difficulty + 6)" />
        </action>

        <action filter="selected_tile=${TILE_CHECKPOINT}">
            <set var="side_distance" value="0" />
        </action>
        <!-- first jump -->
        <action filter="tiles_amount=1">
            <set var="selected_tile" value="${TILE_3}" />
            <set var="side_distance" value="0" />
            <set var="jump_length" value="2" />
        </action>

        <action filter="direction=${SOUTH}">
            <set var="current_z" value="current_z + forward_distance" />
            <set var="current_x" value="current_x + side_distance" />
        </action>
        <action filter="direction=${EAST}">
            <set var="current_x" value="current_x + forward_distance" />
            <set var="current_z" value="current_z + side_distance" />
        </action>
        <action filter="direction=${NORTH}">
            <set var="current_z" value="current_z - forward_distance" />
            <set var="current_x" value="current_x + side_distance" />
        </action>
        <action filter="direction=${WEST}">
            <set var="current_x" value="current_x - forward_distance" />
            <set var="current_z" value="current_z + side_distance" />
        </action>

        <!-- only go up under specific conditions -->
        <action filter="prev_tile=${TILE_CHECKPOINT}">
            <set var="should_go_up" value="1" />
        </action>

        <action filter="not(any(
            prev_tile=${TILE_HEAD},
            selected_tile=${TILE_FENCE},
            all(any(selected_tile=${TILE_GLASS},prev_tile=${TILE_GLASS}),jump_length=3..)
        ))">
            <set var="y_rng" value="floor(random() + 0.2) + should_go_up" />
            <action filter="any(should-turn,should-place-checkpoint,y_rng=1..)">
                <set var="current_y" value="current_y + 1" />
                <set var="should_go_up" value="0" />
            </action>
            <!-- always go up 2 if previous was 'ladder' -->
            <action filter="prev_tile=${TILE_LADDER}">
                <set var="current_y" value="current_y + 2" />
            </action>
        </action>
        <!-- go down if 'fence' is after 'head' -->
        <action filter="all(selected_tile=${TILE_FENCE},prev_tile=${TILE_HEAD})">
            <set var="current_y" value="current_y - 1" />
        </action>

        <!-- paste -->
        <action filter="selected_tile=${TILE_3}">
            <action id="paste-3" />
        </action>
        <action filter="selected_tile=${TILE_2}">
            <action id="paste-2" />
        </action>
        <action filter="selected_tile=${TILE_1}">
            <action id="paste-1" />
        </action>
        <action filter="selected_tile=${TILE_HEAD}">
            <action id="paste-head" />
        </action>
        <action filter="selected_tile=${TILE_FENCE}">
            <action id="paste-fence" />
        </action>
        <action filter="selected_tile=${TILE_TRAPDOOR}">
            <action id="paste-trapdoor" />
        </action>
        <action filter="selected_tile=${TILE_NEO}">
            <action id="paste-neo" />
        </action>
        <action filter="selected_tile=${TILE_LADDER}">
            <action id="paste-ladder" />
        </action>
        <action filter="selected_tile=${TILE_GLASS}">
            <action id="paste-glass" />
        </action>
        <action filter="selected_tile=${TILE_CHECKPOINT}">
            <action id="paste-checkpoint" />
        </action>
        <set var="prev_tile" value="selected_tile" />
        
        <set var="forward_distance" value="forward_distance + tile_length" />

        <action filter="should-turn">
            <set var="direction" value="direction + 1" />
            <action filter="direction=4">
                <set var="direction" value="0" />
            </action>
        </action>
    </action>

