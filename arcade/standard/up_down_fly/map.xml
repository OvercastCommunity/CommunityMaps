<map proto="1.5.1">
<game>Progress</game>
<name>Up Down Fly</name>
<version>1.0.0</version>
<created>2026-08-08</created>
<objective>Be the first to finish the parkour!</objective>
<authors>
    <author uuid="d845eb0b-1ae4-40b7-9287-ec65c22b6e91"/> <!-- Anarquista -->
</authors>
<contributors>
    <contributor uuid="64e840c8-4fb5-4659-a36b-ff93e2f6113a" contribution="XML Help and bugfixes" /> <!-- Javg_ -->
</contributors>
<broadcasts>
    <alert after="0s">The game will start in 10 seconds, get ready!</alert>
</broadcasts>
<players max="100" colors="true"/>
<respawn auto="true"/>
<spawns>
    <spawn yaw="-90" filter="score-0" kit="green-kit">
        <region>
            <cuboid min="-20.5,4,-20.5" max="-6.5,4,-1.5"/>
        </region>
    </spawn>
    <spawn filter="score-1" kit="red-kit">
        <region yaw="0">
            <point>-3.5,250,0</point>
        </region>
    </spawn>
    <spawn yaw="-90" filter="score-2" region="checkpoint-2" kit="blue-kit"/>
    <default kit="night-vision-kit" yaw="-90">
        <region>
            <cuboid min="-20.5,4,-20.5" max="-6.5,4,-1.5"/>
        </region>
    </default>
</spawns>
<kits> 
    <kit id="green-kit" parents="night-vision-kit,resistance-kit,invisibility-kit">
        <boots material="leather boots" team-color="true" locked="true" unbreakable="true" name="`oRunner Boots"/>
        <max-health>20</max-health>
        <health>20</health>
    </kit>
    <kit id="red-kit" parents="night-vision-kit,invisibility-kit">
        <boots material="leather boots" team-color="true" locked="true" unbreakable="true" name="`oRunner Boots"/>
        <effect duration="0">resistance</effect>
        <max-health>1</max-health>
    </kit>
    <kit id="blue-kit" parents="night-vision-kit,invisibility-kit">
        <boots material="leather boots" team-color="true" locked="true" unbreakable="true" name="`oRunner Boots"/>
        <max-health>20</max-health>
        <health>20</health>
        <effect amplifier="10" duration="5s">instant health</effect>
    </kit>
    <kit id="night-vision-kit">
        <effect>night vision</effect>
    </kit>
    <kit id="invisibility-kit">
        <effect>invisibility</effect>
    </kit>
    <kit id="resistance-kit">
        <effect amplifier="5">resistance</effect>
    </kit>
    <give kit="red-kit" filter="red-zone"/>
    <give kit="green-kit" filter="green-zone"/>
    <give kit="blue-kit" filter="blue-zone"/>
</kits>
<regions>
    <apply block="allow-some"/> <!-- ??? -->
    <!-- 1. Main Regions -->
    <cuboid id="spawn-cage-exit" min="-6,5,-6" max="-1,11,-8"/>

    <union id="red-zone">
        <cuboid id="labyrinth" min="-1,89.5,-2" max="-21,102.5,0" />
        <rectangle min="-22,22" max="0,0" />
    </union>
    <complement id="green-zone">
        <rectangle min="-22,-22" max="0,0" />
        <region id="labyrinth" />
    </complement>
    <rectangle id="blue-zone" min="0,-22" max="22,22" />
    <complement id="outside-yellow-zone">
        <cuboid min="22,0,-22" max="50,230,22" />
        <rectangle id="yellow-zone" min="27,-5" max="37,5" />
    </complement>
    
    <cuboid id="checkpoint-1" min="-1,250,-1" max="-6,255,1"/>
    <cuboid id="checkpoint-2" min="-1,4,8" max="1,9,14"/>
    <cuboid id="finish" min="28,4,-4" max="36,10,4"/>

    <!-- 2. Pad Definitions -->
    <cuboid id="green-1" min="1,86,-16" max="2,87,-15"/>
    <cuboid id="green-2" min="2,106,-4" max="3,107,-3"/>
    <cuboid id="green-3" min="18,181,-4" max="19,182,-3"/>
    
    <cylinder id="blue-0" base="11,5,0" radius="1.8" height="1"/>
    <cuboid id="blue-1" min="4,5,-9" max="5,6,-8"/>
    <cuboid id="blue-2" min="17,20,-5" max="18,21,-4"/>
    <cuboid id="blue-3" min="17,29,16" max="18,30,17"/>
    <cuboid id="blue-4" min="2,34,-20" max="3,35,-19"/>
    <cuboid id="blue-5" min="3,48,18" max="4,49,19"/>
    <cuboid id="blue-6" min="10,71,1" max="12,72,3"/>
    <cuboid id="blue-7" min="8.5,69,18" max="13.5,70,19"/>
    <cuboid id="blue-8" min="13,89,-19" max="14,90,-18"/>
    <cuboid id="blue-9" min="20,91,-21" max="21,92,-20"/>
    <cuboid id="blue-10" min="3,103,8" max="4,104,9"/>
    <cuboid id="blue-11" min="19,111,-10" max="20,112,-9"/>
    <cuboid id="blue-12" min="2,116,-9" max="4,117,-7"/>
    <cuboid id="blue-13" min="19,122,18" max="20,123,19"/>
    <cuboid id="blue-14" min="3,146,-4" max="4,147,-3"/>
    <cuboid id="blue-15" min="7,154,18" max="8,155,19"/>
    <cuboid id="blue-16" min="15,164,-4" max="16,165,-3"/>
    <cuboid id="blue-17" min="20,172,3" max="21,173,4"/>
    <cuboid id="blue-18" min="2,179,-13" max="3,180,-12"/>
    <cuboid id="blue-19" min="2,181,4" max="4,182,5"/>
    <cuboid id="blue-20" min="16,185,17" max="17,186,18"/>
    <cuboid id="blue-21" min="3,196,6" max="4,197,7"/>
    <cuboid id="blue-22" min="10,201,-14" max="11,202,-13"/>
    <cuboid id="blue-23" min="8,205,19" max="9,206,20"/>
    <cuboid id="blue-24" min="8,209,12" max="9,210,13"/>
    <cuboid id="blue-25" min="8,217,15" max="9,218,16"/>
    <cuboid id="blue-26" min="14,226,2" max="15,227,3"/>
    <cuboid id="blue-27" min="10,228,-10" max="11,229,-9"/>
    <cuboid id="blue-28" min="13,229,16" max="14,230,17"/>
    <cuboid id="blue-29" min="4,230,8" max="5,231,9"/>
    <cuboid id="blue-30" min="20,232,0" max="21,233,1"/>
    <cuboid id="blue-31" min="6,233,-4" max="7,234,-3"/>
    <cuboid id="blue-32" min="12,234,7" max="13,235,8"/>
    <cuboid id="blue-33" min="6,235,17" max="7,236,18"/>
    <cuboid id="blue-34" min="15,239,-6" max="16,240,-5"/>
    <cuboid id="blue-35" min="1,240,11" max="2,241,12"/>
    <cuboid id="blue-36" min="16,241,7" max="17,242,8"/>
    <cuboid id="blue-37" min="7,244,3" max="8,245,4"/>
    <cuboid id="blue-38" min="17,246,16" max="18,247,17"/>
    <cuboid id="blue-39" min="11,248,19" max="12,249,20"/>
    <cuboid id="blue-40" min="20,248,6" max="21,249,7"/>
    <cuboid id="blue-41" min="18,249,11" max="19,250,12"/>
    <cuboid id="blue-42" min="4,253,15" max="5,254,16"/>

    <!-- 3. Pad Applications -->
    <apply velocity="0,1.35,0" region="green-1"/>
    <apply velocity="0,1.4,0" region="green-2"/>
    <apply velocity="0,2.5,0" region="green-3"/>
    <apply velocity="0,3.3,0" region="blue-0"/>
    <apply velocity="0,2.4,0" region="blue-1"/>
    <apply velocity="0,2,0" region="blue-2"/>
    <apply velocity="0,2,0" region="blue-3"/>
    <apply velocity="0,3.6,0" region="blue-4"/>
    <apply velocity="0,3.7,0" region="blue-5"/>
    <apply velocity="0,3,0" region="blue-6"/>
    <apply velocity="0,3,-2" region="blue-7"/>
    <apply velocity="0,2.4,0" region="blue-8"/>
    <apply velocity="0,2.2,0" region="blue-9"/>
    <apply velocity="0,2,0" region="blue-10"/>
    <apply velocity="0,2.5,0" region="blue-11"/>
    <apply velocity="0,2.6,0" region="blue-12"/>
    <apply velocity="0,1.75,0" region="blue-13"/>
    <apply velocity="0,1.75,0" region="blue-14"/>
    <apply velocity="0,1.2,0" region="blue-15"/>
    <apply velocity="0,1.5,0" region="blue-16"/>
    <apply velocity="0,2.7,0" region="blue-17"/>
    <apply velocity="0,2,0" region="blue-18"/>
    <apply velocity="0,1.38,0.85" region="blue-19"/>
    <apply velocity="0,1.85,0" region="blue-20"/>
    <apply velocity="0,1.3,0" region="blue-21"/>
    <apply velocity="0,1.8,0" region="blue-22"/>
    <apply velocity="-0.9,1.1,0" region="blue-23"/>
    <apply velocity="0,0.8,0" region="blue-24"/>
    <apply velocity="0,2.5,0"> 
        <region>
            <region id="blue-25"/>
            <region id="blue-26"/>
            <region id="blue-27"/>
            <region id="blue-28"/>
            <region id="blue-29"/>
            <region id="blue-30"/>
            <region id="blue-31"/>
            <region id="blue-32"/>
            <region id="blue-33"/>
            <region id="blue-34"/>
            <region id="blue-35"/>
            <region id="blue-36"/>
            <region id="blue-37"/>
            <region id="blue-38"/>
            <region id="blue-39"/>
            <region id="blue-40"/>
            <region id="blue-41"/>
            <region id="blue-42"/>
        </region>
    </apply>
</regions>
<variables scope="match">
    <variable id="players_past_checkpoint_one" />
    <variable id="players_past_checkpoint_two" />
    <variable id="players_past_checkpoint_three" />
    <variable id="i" />
    <variable id="someone_won" />
    <variable id="final_position" scope="player" />
    <variable id="target" scope="player" exclusive="1" />
</variables>
<filters>
    <any id="allow-some">
        <cause>world</cause>
    </any>
    <material id="only-stained-glass">stained glass</material>
    <score id="score-0">0</score>
    <score id="score-1">1</score>
    <score id="score-2">2</score>
    <score id="score-3">3</score>
    <after id="after-10s" message="The glass will be open in {0}" duration="10s">
        <match-started/>
    </after>
</filters>
<actions>
    <trigger scope="player" filter="outside-yellow-zone">
        <action>
            <teleport x="18.5" y="227" z="-16.5" yaw="180" pitch="0" />
            <schedule after="0.01s">
                <kit>
                    <effect duration="2s" amplifier="5">slowness</effect>
                    <effect duration="2s" amplifier="5">blindness</effect>
                    <effect duration="2s" amplifier="5">confusion</effect>
                </kit>
            </schedule>
        </action>
    </trigger>
    <fill id="open-spawn-cage" region="spawn-cage-exit" material="air" filter="only-stained-glass"/>
    <trigger filter="after-10s" action="open-spawn-cage" scope="match"/>
    <!-- messages -->
    <trigger scope="player" filter="all(score-0,after-10s)">
        <action>
            <message title="`a`lStage 1" subtitle="`bGo up, up up!" fade-in="0.5s" fade-out="0.5s" stay="0.5s" />
        </action>
    </trigger>
    <trigger scope="player" filter="score-1">
        <action>
            <set var="players_past_checkpoint_one" value="players_past_checkpoint_one + 1" />
            <set var="target" value="1" />
            <message title="`c`lStage 2" subtitle="`bTime to go down" fade-in="0.5s" fade-out="0.5s" stay="0.5s" />
            <switch-scope inner="match" filter="players_past_checkpoint_one=..3">
                <message text="{player} was the `o{position}`r to finish `a`lStage 1">
                    <replacements>
                        <player id="player" var="target" />
                        <switch id="position" value="players_past_checkpoint_one">
                            <case match="1" result="1st" />
                            <case match="2" result="2nd" />
                            <case match="3" result="3rd" />
                        </switch>
                    </replacements>
                </message>
            </switch-scope>
        </action>
    </trigger>
    <trigger scope="player" filter="score-2">
        <action>
            <set var="players_past_checkpoint_two" value="players_past_checkpoint_two + 1" />
            <message title="`9`lStage 3" subtitle="`bLet's fly!" fade-in="0.5s" fade-out="0.5s" stay="0.5s" />
            <switch-scope inner="match" filter="players_past_checkpoint_two=..3">
                <message text="{player} was the `o{position}`r to finish `c`lStage 2">
                    <replacements>
                        <player id="player" var="target" />
                        <switch id="position" value="players_past_checkpoint_two">
                            <case match="1" result="1st" />
                            <case match="2" result="2nd" />
                            <case match="3" result="3rd" />
                        </switch>
                    </replacements>
                </message>
            </switch-scope>
        </action>
    </trigger>
    <trigger scope="player" filter="score-3">
        <action>
            <set var="players_past_checkpoint_three" value="players_past_checkpoint_three + 1" />
            <set var="final_position" value="players_past_checkpoint_three" />
            <set var="someone_won" value="1" />
            <message title="`e`lYou win!" subtitle="Your position: `e`o{p}{ordinal}" fade-in="0.5s" fade-out="0.5s" stay="2s">
                <replacements>
                    <decimal id="p" value="final_position" />
                    <switch id="ordinal" value="final_position">
                        <case match="1" result="st" />
                        <case match="21" result="st" />
                        <case match="31" result="st" />
                        <case match="41" result="st" />
                        <case match="51" result="st" />
                        <case match="61" result="st" />
                        <case match="71" result="st" />
                        <case match="81" result="st" />
                        <case match="91" result="st" />
                        <case match="2" result="nd" />
                        <case match="22" result="nd" />
                        <case match="32" result="nd" />
                        <case match="42" result="nd" />
                        <case match="52" result="nd" />
                        <case match="62" result="nd" />
                        <case match="72" result="nd" />
                        <case match="82" result="nd" />
                        <case match="92" result="nd" />
                        <case match="3" result="rd" />
                        <case match="23" result="rd" />
                        <case match="33" result="rd" />
                        <case match="43" result="rd" />
                        <case match="53" result="rd" />
                        <case match="63" result="rd" />
                        <case match="73" result="rd" />
                        <case match="83" result="rd" />
                        <case match="93" result="rd" />
                        <fallback>th</fallback>
                    </switch>
                </replacements>
            </message>
            <switch-scope inner="match" filter="players_past_checkpoint_three=..3">
                <message text="{player} was the `o{position}`r to finish `9`lStage 3">
                    <replacements>
                        <player id="player" var="target" />
                        <switch id="position" value="players_past_checkpoint_three">
                            <case match="1" result="1st" />
                            <case match="2" result="2nd" />
                            <case match="3" result="3rd" />
                        </switch>
                    </replacements>
                </message>
            </switch-scope>
        </action>
    </trigger>
    <!-- finish game -->
    <trigger scope="match">
        <filter>
            <after duration="30s" filter="someone_won=1" message="There's a winner! Game ending in {0}" />
        </filter>
        <action>
            <set var="i" value="1" />
            <repeat times="players_past_checkpoint_three" filter="not(someone_won=2)">
                <switch-scope inner="player" filter="final_position-i=0">
                    <set var="score" value="score + 1" />
                    <set var="someone_won" value="2" />
                </switch-scope>
                <set var="i" value="i + 1" />
            </repeat>
        </action>
    </trigger>
</actions>
<score>
    <limit>4</limit>
    <box points="1" region="checkpoint-1" filter="score-0" silent="true"/>
    <box points="1" region="checkpoint-2" filter="score-1" silent="true"/>
    <box points="1" region="finish" filter="score-2" />
</score>
<disabledamage>
    <damage>entity attack</damage>
</disabledamage>
<damage>
    <deny>
        <any>
            <cause>melee</cause>
            <cause>suffocation</cause>
            <all>
                <cause>fall</cause>
                <not>
                    <filter id="red-zone" />
                </not>
            </all>
        </any>
    </deny>
</damage>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>