<map proto="1.5.1">
<name>Infinity Race</name>
<version>1.0</version>
<objective>Get as far as you can in the parkour!</objective>
<created>2026-08-29</created>
<game>Parkour</game>
<phase>development</phase>
<include id="void-death" />
<authors>
    <author uuid="64e840c8-4fb5-4659-a36b-ff93e2f6113a" contribution="Idea and XML" /> <!-- Javg_ -->
    <author uuid="ec5ec930-5cf3-4f8a-ad9f-09056aeed71b" contribution="Spawn" /> <!-- Tundren -->
    <author uuid="b2539be1-8f98-4375-b653-9d91cd04c30e" contribution="Spawn" /> <!-- Mewzzy -->
</authors>
<constants>
    <constant id="TILE_1">3</constant>
    <constant id="TILE_2">2</constant>
    <constant id="TILE_3">1</constant>
    <constant id="TILE_LADDER">4</constant>
    <constant id="TILE_TRAPDOOR">5</constant>
    <constant id="TILE_GLASS">6</constant>
    <constant id="TILE_NEO">7</constant>
    <constant id="TILE_HEAD">8</constant>
    <constant id="TILE_FENCE">9</constant>
    <constant id="TILE_CHECKPOINT">100</constant>
</constants>
<kits>
    <kit id="default-kit">
        <game-mode>adventure</game-mode>
        <effect duration="oo">invisibility</effect>
        <boots material="leather boots" team-color="true" />
    </kit>
</kits>
<spawns>
    <default>
        <region>
            <point>1.5,3,-8.2</point>
        </region>
    </default>
    <spawn kit="default-kit">
        <region>
            <point>1.5,3,-2.5</point>
        </region>
    </spawn>
</spawns>
<players max="80" colors="true" show-name-tags="false" />
<score />
<time>5m</time>
<filters>
    <offset id="on-checkpoint" vector="~0,~-1,~0">
        <material>gold block</material>
    </offset>
    <time id="after-1">3s</time>
</filters>
<structures>
    <structure id="tile-3-struct-1" air="false">
        <region>
            <cuboid min="-22,1,-1" max="-25,2,2" />
        </region>
    </structure>
    <structure id="tile-3-struct-2" air="false">
        <region>
            <cuboid min="-22,1,-6" max="-25,2,-3" />
        </region>
    </structure>
    <structure id="tile-3-struct-3" air="false">
        <region>
            <cuboid min="-22,1,-11" max="-25,2,-8" />
        </region>
    </structure>
    <structure id="tile-3-struct-4" air="false">
        <region>
            <cuboid min="-22,1,-16" max="-25,3,-13" />
        </region>
    </structure>
    <structure id="tile-3-struct-5" air="false">
        <region>
            <cuboid min="-22,1,-21" max="-25,3,-18" />
        </region>
    </structure>
    <structure id="tile-2-struct-1" air="false">
        <region>
            <cuboid min="-26,1,-1" max="-28,2,1" />
        </region>
    </structure>
    <structure id="tile-2-struct-2" air="false">
        <region>
            <cuboid min="-26,1,-5" max="-28,2,-3" />
        </region>
    </structure>
    <structure id="tile-2-struct-3" air="false">
        <region>
            <cuboid min="-26,1,-10" max="-28,2,-8" />
        </region>
    </structure>
    <structure id="tile-2-struct-4" air="false">
        <region>
            <cuboid min="-26,1,-15" max="-28,3,-13" />
        </region>
    </structure>
    <structure id="tile-2-struct-5" air="false">
        <region>
            <cuboid min="-26,1,-20" max="-28,3,-18" />
        </region>
    </structure>
    <structure id="tile-1-struct-1" air="false">
        <region>
            <cuboid min="-29,1,-1" max="-30,2,0" />
        </region>
    </structure>
    <structure id="tile-1-struct-2" air="false">
        <region>
            <cuboid min="-29,1,-4" max="-30,2,-3" />
        </region>
    </structure>
    <structure id="tile-1-struct-3" air="false">
        <region>
            <cuboid min="-29,1,-9" max="-30,2,-8" />
        </region>
    </structure>
    <structure id="tile-1-struct-4" air="false">
        <region>
            <cuboid min="-29,1,-14" max="-30,2,-13" />
        </region>
    </structure>
    <structure id="tile-head-struct" air="false">
        <region>
            <cuboid min="-31,1,-1" max="-32,2,0" />
        </region>
    </structure>
    <structure id="tile-trapdoor-struct" air="false">
        <region>
            <cuboid min="-32,1,-1" max="-35,4,1" />
        </region>
    </structure>
    <structure id="tile-ladder-struct-1" air="false">
        <region>
            <cuboid min="-35,1,-2" max="-38,4,0" />
        </region>
    </structure>
    <structure id="tile-ladder-struct-2" air="false">
        <region>
            <cuboid min="-35,1,-5" max="-38,4,-3" />
        </region>
    </structure>
    <structure id="tile-ladder-struct-3" air="false">
        <region>
            <cuboid min="-35,1,-8" max="-38,4,-6" />
        </region>
    </structure>
    <structure id="tile-neo-struct" air="false">
        <region>
            <cuboid min="-39,1,-1" max="-40,4,4" />
        </region>
    </structure>
    <structure id="tile-fence-struct" air="false">
        <region>
            <cuboid min="-41,1,-1" max="-42,2,0" />
        </region>
    </structure>
    <structure id="tile-glass-struct-1" air="false">
        <region>
            <cuboid min="-48,1,-1" max="-49,2,1" />
        </region>
    </structure>
    <structure id="tile-glass-struct-2" air="false">
        <region>
            <cuboid min="-48,1,-4" max="-50,2,-3" />
        </region>
    </structure>
    <structure id="tile-glass-struct-3" air="false">
        <region>
            <cuboid min="-48,1,-7" max="-50,2,-5" />
        </region>
    </structure>
    <structure id="tile-checkpoint-struct" air="false">
        <region>
            <cuboid min="-43,1,-1" max="-46,2,2" />
        </region>
    </structure>
</structures>
<variables scope="match">
    <variable id="last_distance" default="5" />
    <variable id="tiles_amount" />
    <variable id="current_x" default="1" />
    <variable id="current_y" default="3" />
    <variable id="current_z" default="5" />
    <variable id="z_offset" />
    <variable id="next_tile" />
    <variable id="prev_tile" />
    <variable id="difficulty" default="1" />
    <variable id="max_z" />
    <variable id="jump_length" />
    <variable id="variant_rng" />
    <variable id="next_step" default="5" />
    <array id="checkpoint" size="3" scope="player" default="-1" />
    <variable id="just_lost" scope="player" />
</variables>
<actions>
    <trigger scope="match" action="generate">
        <filter>
            <pulse duration="1s" period="4s" filter="all(always,not(match-running))" />
        </filter>
    </trigger>

    <trigger scope="match" filter="match-started">
        <action>
            <repeat times="5" filter="tiles_amount=..5">
                <action id="generate" />
            </repeat>
        </action>
    </trigger>

    <trigger scope="player" filter="all(after-1,dead)" action="just_lost := 1" />
    <trigger scope="player" filter="all(after-1,alive,just_lost=1)">
        <action>
            <set var="just_lost" value="0" />
            <action filter="not(checkpoint[1]=-1)">
                <teleport x="checkpoint[0]" y="checkpoint[1]" z="checkpoint[2]" />
            </action>
        </action>
    </trigger>

    <trigger scope="match">
        <filter>
            <pulse duration="0.1s" period="0.2s" filter="match-running" />
        </filter>
        <action>
            <switch-scope inner="player" filter="alive">
                <set var="max_z" value="max(max_z,player.z)" />
                <set var="score" value="max(score, player.z)" />
                
                <action filter="all(on-checkpoint,player.z-checkpoint[2]=3..)">
                    <set var="checkpoint" index="0" value="player.x" />
                    <set var="checkpoint" index="1" value="player.y" />
                    <set var="checkpoint" index="2" value="player.z" />
                    <message text="`e`lCheckpoint!" />
                    <sound key="random.levelup" volume="0.5" />
                </action>
            </switch-scope>
            <action filter="max_z-next_step=0..">
                <set var="next_step" value="next_step + last_distance" />
                <action id="generate" />
            </action>
        </action>
    </trigger>

    <action id="generate" scope="match" expose="true">
        <set var="last_distance" value="0" />

        <action filter="tiles_amount=0">
            <set var="next_tile" value="${TILE_3}" />
        </action>
        <action filter="not(tiles_amount=0)">
            <set var="next_tile" value="floor(random() * (1 + 8 * difficulty / 100)) + 1" />
        </action>
        <action filter="all(tiles_amount%20=0,not(tiles_amount=0))">
            <set var="next_tile" value="${TILE_CHECKPOINT}" />
        </action>

        <set var="current_z" value="current_z + jump_length" />
        <set var="jump_length" value="2 + floor(random() * 2)" />

        <action filter="all(prev_tile=${TILE_HEAD},next_tile=${TILE_FENCE})">
            <set var="jump_length" value="1" />
        </action>
        <set var="last_distance" value="jump_length" />

        <action filter="not(tiles_amount=0)">
            <action filter="all(not(prev_tile=${TILE_HEAD}),not(next_tile=${TILE_HEAD}),not(prev_tile=${TILE_FENCE}),not(next_tile=${TILE_FENCE}))">
                <set var="current_y" value="current_y + floor(random() + 0.2)" />
            </action>
            <action filter="prev_tile=${TILE_LADDER}">
                <set var="current_y" value="current_y + 2" />
            </action>
        </action>

        <action filter="not(tiles_amount=0)">
            <action filter="not(prev_tile=${TILE_TRAPDOOR})">
                <set var="current_x" value="current_x + floor(random() * 3) * (floor(random() * 2) * 2 - 1)" />
            </action>
            <action filter="next_tile=${TILE_FENCE}">
                <set var="current_x" value="current_x + floor(random() * 2) * (floor(random() * 2) * 2 - 1)" />
            </action>
        </action>

        <action filter="next_tile=${TILE_1}">
            <action id="gen-1" />
        </action>
        <action filter="next_tile=${TILE_2}">
            <action id="gen-2" />
        </action>
        <action filter="next_tile=${TILE_3}">
            <action id="gen-3" />
        </action>
        <action filter="next_tile=${TILE_HEAD}">
            <action id="gen-head" />
        </action>
        <action filter="next_tile=${TILE_TRAPDOOR}">
            <action id="gen-trapdoor" />
        </action>
        <action filter="next_tile=${TILE_LADDER}">
            <action id="gen-ladder" />
        </action>
        <action filter="next_tile=${TILE_NEO}">
            <action id="gen-neo" />
        </action>
        <action filter="next_tile=${TILE_FENCE}">
            <action id="gen-fence" />
        </action>
        <action filter="next_tile=${TILE_GLASS}">
            <action id="gen-glass" />
        </action>
        <action filter="next_tile=${TILE_CHECKPOINT}">
            <action id="gen-checkpoint" />
        </action>

        <set var="tiles_amount" value="tiles_amount + 1" />

        <action filter="tiles_amount%10=0">
            <set var="difficulty" value="min(100, difficulty + 7)" />
        </action>
    </action>

    <action id="gen-3" scope="match">
        <set var="variant_rng" value="floor(random() * 5)" />
        <action filter="variant_rng=0">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-3-struct-1" update="false" />
        </action>
        <action filter="variant_rng=1">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-3-struct-2" update="false" />
        </action>
        <action filter="variant_rng=2">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-3-struct-3" update="false" />
        </action>
        <action filter="variant_rng=3">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-3-struct-4" update="false" />
        </action>
        <action filter="variant_rng=4">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-3-struct-5" update="false" />
        </action>
        <set var="current_z" value="current_z + 3" />
        <set var="last_distance" value="last_distance + 3" />
        <set var="prev_tile" value="${TILE_3}" />
    </action>

    <action id="gen-2" scope="match">
        <set var="variant_rng" value="floor(random() * 5)" />
        <action filter="variant_rng=0">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-2-struct-1" update="false" />
        </action>
        <action filter="variant_rng=1">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-2-struct-2" update="false" />
        </action>
        <action filter="variant_rng=2">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-2-struct-3" update="false" />
        </action>
        <action filter="variant_rng=3">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-2-struct-4" update="false" />
        </action>
        <action filter="variant_rng=4">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-2-struct-5" update="false" />
        </action>
        <set var="current_z" value="current_z + 2" />
        <set var="last_distance" value="last_distance + 2" />
        <set var="prev_tile" value="${TILE_2}" />
    </action>

    <action id="gen-1" scope="match">
        <set var="variant_rng" value="floor(random() * 4)" />
        <action filter="variant_rng=0">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-1-struct-1" update="false" />
        </action>
        <action filter="variant_rng=1">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-1-struct-2" update="false" />
        </action>
        <action filter="variant_rng=2">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-1-struct-3" update="false" />
        </action>
        <action filter="variant_rng=3">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-1-struct-4" update="false" />
        </action>
        <set var="current_z" value="current_z + 1" />
        <set var="last_distance" value="last_distance + 1" />
        <set var="prev_tile" value="${TILE_1}" />
    </action>

    <action id="gen-head" scope="match">
        <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-head-struct" update="false" />
        <set var="current_z" value="current_z + 1" />
        <set var="last_distance" value="last_distance + 1" />
        <set var="prev_tile" value="${TILE_HEAD}" />
    </action>

    <action id="gen-trapdoor" scope="match">
        <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-trapdoor-struct" update="false" />
        <set var="current_z" value="current_z + 2" />
        <set var="last_distance" value="last_distance + 2" />
        <set var="prev_tile" value="${TILE_TRAPDOOR}" />
    </action>

    <action id="gen-ladder" scope="match">
        <set var="variant_rng" value="floor(random() * 3)" />
        <action filter="variant_rng=0">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-ladder-struct-1" update="false" />
        </action>
        <action filter="variant_rng=1">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-ladder-struct-2" update="false" />
        </action>
        <action filter="variant_rng=2">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-ladder-struct-3" update="false" />
        </action>
        <set var="current_z" value="current_z + 2" />
        <set var="last_distance" value="last_distance + 2" />
        <set var="prev_tile" value="${TILE_LADDER}" />
    </action>

    <action id="gen-glass" scope="match">
        <set var="variant_rng" value="floor(random() * 3)" />
        <action filter="variant_rng=0">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-glass-struct-1" update="false" />
            <set var="last_distance" value="last_distance + 1" />
        </action>
        <action filter="variant_rng=1">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-glass-struct-2" update="false" />
            <set var="last_distance" value="last_distance + 2" />
        </action>
        <action filter="variant_rng=2">
            <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-glass-struct-3" update="false" />
            <set var="last_distance" value="last_distance + 2" />
        </action>
        <set var="current_z" value="current_z + 2" />
        <set var="prev_tile" value="${TILE_GLASS}" />
    </action>

    <action id="gen-neo" scope="match">
        <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-neo-struct" update="false" />
        <set var="current_z" value="current_z + 5" />
        <set var="last_distance" value="last_distance + 5" />
        <set var="prev_tile" value="${TILE_NEO}" />
    </action>

    <action id="gen-fence" scope="match">
        <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-fence-struct" update="false" />
        <set var="current_z" value="current_z + 1" />
        <set var="last_distance" value="last_distance + 1" />
        <set var="prev_tile" value="${TILE_FENCE}" />
    </action>

    <action id="gen-checkpoint" scope="match">
        <paste-structure x="current_x" y="current_y" z="current_z" structure="tile-checkpoint-struct" update="false" />
        <set var="current_z" value="current_z + 3" />
        <set var="last_distance" value="last_distance + 3" />
        <set var="prev_tile" value="${TILE_CHECKPOINT}" />
    </action>

</actions>
<hunger>
    <depletion>off</depletion>
</hunger>
<damage>
    <deny>
        <any>
            <cause>fall</cause>
            <attacker>
                <always/>
            </attacker>
        </any>
    </deny>
</damage>
</map>