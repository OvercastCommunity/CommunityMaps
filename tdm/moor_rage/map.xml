<map proto="1.5.0">
<name>Moor RAGE</name>
<version>1.0.4</version>
<objective>Be the team with the most kills after 8 minutes!</objective>
<created>2022-04-22</created>
<gamemode>tdm</gamemode>
<phase>staging</phase>
<authors>
    <author uuid="2ca8072f-74be-4798-85b8-bbce03aa91af"/> <!-- Tywnis -->
</authors>
<teams>
    <team id="blue-team" color="blue" max="10" max-overfill="12">Blue</team>
    <team id="yellow-team" color="yellow" max="10" max-overfill="12">Yellow</team>
</teams>
<broadcasts>
    <tip after="10s" every="2m">Jump into the scoreboxes with Emeralds to score more points!</tip>
</broadcasts>
<kits>
    <kit id="spawn-kit">
        <item slot="0" unbreakable="true" enchantment="damage all:10" lore="`aOne hit slice!" material="iron sword"/>
        <item slot="1" unbreakable="true" enchantment="arrow damage:10" lore="`aOne shot pierce!" material="bow"/>
        <item slot="8" amount="2" material="arrow"/>
        <helmet team-color="true" unbreakable="true" material="leather helmet"/>
        <chestplate unbreakable="true" material="chainmail chestplate"/>
        <leggings team-color="true" unbreakable="true" material="leather leggings"/>
        <boots team-color="true" unbreakable="true" enchantment="protection fall" material="leather boots"/>
        <effect duration="4s" amplifier="25">heal</effect>
        <effect duration="4s" amplifier="25">damage resistance</effect>
        <game-mode>adventure</game-mode>
    </kit>
    <kit id="obs">
        <effect>night vision</effect>
    </kit>
</kits>
<spawns>
    <default yaw="-90" kit="obs">
        <regions>
            <cylinder base="5.5,7,34.5" radius="2" height="0"/>
        </regions>
    </default>
    <spawn team="blue-team" kit="spawn-kit" yaw="180">
        <regions>
            <point>8,31,96</point>
        </regions>
    </spawn>
    <spawn team="yellow-team" kit="spawn-kit">
        <regions>
            <point>0,31,-27</point>
        </regions>
    </spawn>
</spawns>
<regions>
    <apply block="never"/>
    <apply enter="yellow-team" region="blue-scorebox" message="You may not enter your own scorebox!"/>
    <apply enter="blue-team" region="yellow-scorebox" message="You may not enter your own scorebox!"/>
</regions>
<time result="score">8m</time>
<score>
    <!-- Only allow yellow team to use this score box, and give them 1 points -->
    <box points="1" filter="yellow-team">
        <region>
            <cylinder id="blue-scorebox" base="2.5,20,73.5" radius="1" height="3"/>
        </region>
        <redeemables>
            <item points="2">emerald</item>
        </redeemables>
    </box>
    <!-- Only allow blue team to use this score box, and give them 1 points -->
    <box points="1" filter="blue-team">
        <region>
            <cylinder id="yellow-scorebox" base="6.5,20,-4.5" radius="1" height="3"/>
        </region>
        <redeemables>
            <item points="2">emerald</item>
        </redeemables>
    </box>
    <kills>1</kills>
</score>
<rage/>
<portals>
    <!-- Moves the player to exactly X:10 Y:8 Z:45, pitch & yaw remain unchanged -->
    <portal x="@0" y="@31" z="@-27">
        <region>
            <cylinder base="2.5,20,73.5" radius="1" height="3"/>
        </region>
    </portal>
    <portal x="@8" y="@31" z="@96">
        <region>
            <cylinder base="6.5,20,-4.5" radius="1" height="3"/>
        </region>
    </portal>
</portals>
<itemremove>
    <item>leather helmet</item>
    <item>chainmail chestplate</item>
    <item>leather leggings</item>
    <item>leather boots</item>
    <item>emerald</item>
    <item>arrow</item>
</itemremove>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
</toolrepair>
<kill-rewards>
    <kill-reward>
        <item material="emerald"/> <!-- Used to score more points in boxes -->
        <item material="arrow"/>
    </kill-reward>
</kill-rewards>
<timelock>on</timelock>
<disabledamage>
    <damage>fall</damage>
</disabledamage>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>