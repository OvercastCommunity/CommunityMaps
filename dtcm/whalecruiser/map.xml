<map proto="1.5.1">
<version>1.0.2</version>
<name>Whalecruiser</name>
<created>2026-08-13</created>
<phase>development</phase>
<gamemode>dtm</gamemode>
<variant id="dte" world="DTE">DTE</variant>
<authors>
    <author uuid="4d6ecfd1-2e0e-49b6-83c6-e230efe448d4"/> <!-- 3lii3 -->
</authors>
<if variant="dte">
    <objective>Destroy 80% of your enemy's cruiser to win!</objective>
    <contributors>
        <contributor uuid="dad8b95c-cf6a-44df-982e-8c8dd70201e0" contribution="Original DATAcenter map"/> <!-- ElectroidFilms -->
        <contributor uuid="e37f18f1-117b-47db-8806-6d3a0854b518" contribution="Original DATAcenter map"/> <!-- chickolympics -->
        <contributor uuid="459fd919-0d58-401a-9601-6cab1eb721ab" contribution="Original DATAcenter map"/> <!-- Reshif -->
        <contributor uuid="621b2aa8-4e5f-4ed8-bd36-0ae2f8952a06" contribution="Original DATAcenter map"/> <!-- thestrangeboy1 -->
    </contributors>
</if>
<unless variant="dte">
<gamemode>dtc</gamemode>
<objective>Destroy your opponent's monument and leak their core to win!</objective>
</unless>
<include id="gapple-kill-reward"/>
<maxbuildheight>37</maxbuildheight>
<teams>
    <team id="blue" color="BLUE" max="15">Blue</team>
    <team id="red" color="RED" max="15">Red</team>
</teams>
<world>
    <timeset>18000</timeset>
</world>
<kits>
    <kit id="parent-kit">
        <item slot="0" material="iron sword" unbreakable="true" name="`e`lWhaletooth"/>
        <item slot="1" material="bow" unbreakable="true" name="`6`lAnti-Cruising Rifle"/>w
        <item slot="2" material="diamond pickaxe" unbreakable="true"/>
        <item slot="3" material="iron axe" unbreakable="true"/>
        <item slot="29" material="arrow" amount="48"/>
        <helmet team-color="true" material="leather helmet" unbreakable="true">
            <enchantment level="3">blast protection</enchantment>
        </helmet>
        <chestplate team-color="true" material="leather chestplate" unbreakable="true">
            <enchantment level="3">blast protection</enchantment>
        </chestplate>
    </kit>
    <if variant="dte">
        <kit id="default-kit" parents="parent-kit">
            <item slot="4" amount="64" material="wood"/>
            <item slot="31" amount="64" material="wood"/>
            <item slot="22" amount="64" material="wood"/>
            <item slot="23" amount="16" material="redstone block"/>
            <item slot="5" amount="64" material="tnt"/>
            <item slot="32" amount="64" material="tnt"/>
            <item slot="6" material="water bucket"/>
            <item slot="33" material="water bucket"/>
            <item slot="24" amount="8" material="fence gate"/>
            <item slot="15" amount="8" material="trap door"/>
            <item slot="7" amount="16" material="wood step"/>
            <item slot="8" amount="8" material="redstone"/>
            <item slot="34" amount="8" material="fence"/>
            <item slot="35" amount="8" material="ladder"/>
            <item slot="25" amount="4" material="diode"/>
            <item slot="26" amount="16" material="stone button"/>
            <item slot="16" amount="16" material="lever"/>
            <item slot="17" amount="16" material="stone plate"/>
            <effect>fast digging</effect>
            <effect>water breathing</effect>
            <effect>damage resistance</effect>
        </kit>
    </if>
    <unless variant="dte">
        <kit id="default-kit" parents="parent-kit">
            <item slot="4" material="quartz block" amount="64"/>
            <item slot="5" material="dark oak planks" amount="32"/>
            <item slot="6" material="tnt" amount="64"/>
            <item slot="7" material="water bucket" amount="1"/>
            <item slot="8" material="golden apple" amount="1"/>
            <item slot="31" material="iron spade" unbreakable="true"/>
            <item slot="32" material="sponge" amount="4"/>
        </kit>
    </unless>
</kits>
<spawns>
    <if variant="dte">
        <default>
            <region yaw="0">
                <point>-0.5,97,-36.5</point>
            </region>
        </default>
        <spawn team="red" kit="default-kit">
            <region>
                <point>-0.5,91,-42.5</point>
            </region>
        </spawn>
        <spawn team="blue" kit="default-kit">
            <region yaw="180">
                <point>-0.5,91,43.5</point>
            </region>
        </spawn>
    </if>
    <unless variant="dte">
        <default>
            <region yaw="0">
                <point>-0.5,97,-52.5</point>
            </region>
        </default>
        <spawn team="red" kit="default-kit">
            <region>
                <point>-0.5,91,-58.5</point>
            </region>
        </spawn>
        <spawn team="blue" kit="default-kit">
            <region yaw="180">
                <point>-0.5,91,59.5</point>
            </region>
        </spawn>
    </unless>
</spawns>
<filters>
    <deny id="deny-fire">
        <material>fire</material>
    </deny>
</filters>
<regions>
    <unless variant="dte">
        <union id="spawn-tubes">
            <circle id="blue-spawn-tube" center="-0.5,53.5" radius="3.5"/>
            <circle id="red-spawn-tube" center="-0.5,-52.5" radius="3.5"/>
        </union>
        <sphere id="blue-core" origin="-19.5,13.5,53.5" radius="3"/>
        <sphere id="red-core" origin="-19.5,13.5,-52.5" radius="3"/>
        <cuboid id="blue-monument-region" min="10,0,10" max="37,12,35"/>
        <cuboid id="red-monument-region" min="10,0,-9" max="37,12,-34"/>
        <apply block="never" region="outside-gameplay-area" message="You may not build outside the map!"/>
        <negative id="outside-gameplay-area">
            <rectangle min="-34,-74" max="37,75"/>
        </negative>
    </unless>
    <if variant="dte">
        <union id="spawn-tubes">
            <circle id="blue-spawn-tube" center="-0.5,37.5" radius="3.5"/>
            <circle id="red-spawn-tube" center="-0.5,-36.5" radius="3.5"/>
        </union>
        <cuboid id="blue-cruiser" min="-34,0,16" max="30,36,59"/>
        <cuboid id="red-cruiser" min="-34,0,-15" max="30,36,-58"/>
        <negative id="outside-gameplay-area">
            <rectangle min="-34,-58" max="37,59"/>
        </negative>
    </if>
    <above y="38" id="above-limit"/>
    <apply region="everywhere" block-place="deny-fire"/>
    <apply block="never" region="spawn-tubes"/>
    <apply block="never" region="above-limit" message="You may not build out of bounds!"/>
</regions>
<unless variant="dte">
    <destroyables name="Baby Cruiser" show-progress="true" completion="80%" repairable="false" required="true" >
        <destroyable id="blue-monument" materials="stained clay;iron block;quartz block;stained glass;43;44;sea lantern;clay;stone" owner="blue" region="blue-monument-region"/>
        <destroyable id="red-monument" materials="stained clay;iron block;quartz block;stained glass;43;44;sea lantern;clay;stone" owner="red" region="red-monument-region"/>
    </destroyables>
    <cores>
        <core name="Engine Core" team="blue" material="obsidian" leak="3" region="blue-core" required="true"/>
        <core name="Engine Core" team="red" material="obsidian" leak="3" region="red-core" required="true"/>
    </cores>
</unless>
<if variant="dte">
    <destroyables name="Cruiser" show-progress="true" completion="80%" repairable="false" required="true" >
        <destroyable id="blue-monument" materials="stained clay;iron block;quartz block;light blue stained glass;sea lantern;clay;stone;chest;cobblestone wall;iron bars;43;44;coal block" owner="blue" region="blue-cruiser"/>
        <destroyable id="red-monument" materials="stained clay;iron block;quartz block;light blue stained glass;sea lantern;clay;stone;chest;cobblestone wall;iron bars;43;44;coal block" owner="red" region="red-cruiser"/>
    </destroyables>
</if>
<itemremove>
    <item>flint and steel</item>
    <item>arrow</item>
    <item>step</item>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>shears</item>
    <item>rails</item>
    <item>ladder</item>
    <item>gold block</item>
    <item>obsidian</item>
    <item>stained clay</item>
    <item>quartz block</item>
    <item>bucket</item>
    <item>water bucket</item>
    <item>stone plate</item>
    <item>diode</item>
    <item>lever</item>
    <item>iron door</item>
    <item>fence</item>
    <item>wood</item>
    <item>tnt</item>
    <item>stone button</item>
    <item>redstone</item>
    <item>ladder</item>
    <item>log</item>
    <item>wood step</item>
    <item>gravel</item>
    <item>flint</item>
    <item>trap door</item>
    <item>fence gate</item>
</itemremove>
<toolrepair>
    <tool>iron sword</tool>
    <tool>diamond pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
    <tool>bow</tool>
</toolrepair>
<kill-rewards>
    <kill-reward>
        <item amount="16" material="wood"/>
        <item amount="16" material="tnt"/>
    </kill-reward>
</kill-rewards>
<block-drops>
    <rule region="everywhere" wrong-tool="true">
        <drops>
        </drops>
    </rule>
</block-drops>
<gamerules>
    <randomTickSpeed>0</randomTickSpeed>
    <doFireTick>false</doFireTick>
    <doTileDrops>false</doTileDrops>
</gamerules>
<if variant="dte">
    <disabledamage>
        <damage>fall</damage>
    </disabledamage>
</if>
<hunger>
    <depletion>off</depletion>
</hunger>
<respawn delay="3s"/>
</map>
