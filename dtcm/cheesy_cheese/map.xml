<map proto="1.5.1">
<name>Cheesy Cheese</name>
<version>1.0.0</version>
<objective>Destroy the enemy team's two obsidian monuments!</objective>
<created>2026-10-20</created>
<phase>staging</phase>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="644521d7-9437-47c1-b1d2-698eb757df3d"/> <!-- minuyo -->
</authors>
<contributors>
    <contributor uuid="63ddf58a-ba2c-4d39-8481-6358bb46c63a" contribution="xml"/> <!-- samschaap -->
</contributors>
<teams>
    <team id="pink-team" color="light purple" max="22">Pink</team>
    <team id="blue-team" color="blue" max="22">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" material="bow"/>
        <item slot="28" material="arrow" amount="64"/>
        <item slot="2" unbreakable="true" material="diamond pickaxe"/>
        <item slot="3" unbreakable="true" material="iron axe"/>
        <item slot="30" unbreakable="true" material="iron spade"/>
        <item slot="4" amount="64" material="wood"/>
        <item slot="31" amount="64" material="wood"/>
        <item slot="5" amount="32" material="glass"/>
        <item slot="7" material="water bucket"/>
        <item slot="8" material="golden apple"/>
        <item slot="35" material="monster egg" damage="92"/>
        <effect duration="3s" amplifier="255">damage resistance</effect>
    </kit>
    <kit id="pink-kit" parents="spawn-kit">
        <helmet unbreakable="true" color="ff99bf" material="leather helmet"/>
        <chestplate unbreakable="true" color="ff99bf" material="leather chestplate"/>
        <leggings unbreakable="true" color="ff99bf" material="leather leggings"/>
        <boots unbreakable="true" color="ff99bf" material="leather boots"/>
    </kit>
    <kit id="blue-kit" parents="spawn-kit">
        <helmet unbreakable="true" color="7fccff" material="leather helmet"/>
        <chestplate unbreakable="true" color="7fccff" material="leather chestplate"/>
        <leggings unbreakable="true" color="7fccff" material="leather leggings"/>
        <boots unbreakable="true" color="7fccff" material="leather boots"/>
    </kit>
</kits>
<spawns>
    <default yaw="180">
        <region>
            <point>0.5,102,63.6</point>
        </region>
    </default>
    <spawn team="pink-team" kit="pink-kit" yaw="90">
        <region>
            <point>99.5,17,9.5</point>
        </region>
    </spawn>
    <spawn team="blue-team" kit="blue-kit" yaw="-90">
        <region>
            <point>-98.5,17,-8.5</point>
        </region>
    </spawn>
</spawns>
<filters>
    <all id="only-iron-renew">
        <material id="only-iron">iron block</material>
        <cause>world</cause>
    </all>
</filters>
<regions>
    <negative id="void-area">
        <rectangle id="playable-area" min="-105,-30" max="106,31"/>
    </negative>
    <union id="spawns">
        <cuboid id="pink-spawn" min="94,13,14" max="105,oo,-11"/>
        <cuboid id="blue-spawn" min="-93,13,-13" max="-104,oo,12"/>
    </union>
    <cuboid id="pink-front-monument" min="47,16,9" max="48,18,10"/>
    <cuboid id="pink-back-monument" min="76,16,-18" max="77,18,-17"/>
    <cuboid id="blue-front-monument" min="-46,16,-8" max="-47,18,-9"/>
    <cuboid id="blue-back-monument" min="-75,16,19" max="-76,18,18"/>
    <apply block-break="only-iron" block-place="only-iron-renew" region="spawns" message="You may not modify the spawn area!"/>
    <apply enter="pink-team" region="pink-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply enter="blue-team" region="blue-spawn" message="You may not enter the enemy team's spawn!"/>
    <apply block="deny(void)" region="void-area" message="You may not modify the void area!"/>
</regions>
<destroyables material="obsidian" mode-changes="true">
    <destroyable name="Front Monument" owner="pink-team" region="pink-front-monument"/>
    <destroyable name="Back Monument" owner="pink-team" region="pink-back-monument"/>
    <destroyable name="Front Monument" owner="blue-team" region="blue-front-monument"/>
    <destroyable name="Back Monument" owner="blue-team" region="blue-back-monument"/>
</destroyables>
<modes>
    <mode after="20m" material="beacon" name="`eBeacon Mode"/>
    <mode after="40m" material="coal block" name="`8Coal Block Mode"/>
</modes>
<renewables>
    <renewable region="spawns" renew-filter="only-iron"/>
</renewables>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>diamond pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
    <tool>bucket</tool>
    <tool>water bucket</tool>
</toolrepair>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>leather leggings</item>
    <item>leather boots</item>
    <item>obsidian</item>
    <item>beacon</item>
    <item>coal block</item>
</itemremove>
<itemkeep>
    <item>arrow</item>
    <item>wood</item>
    <item>glass</item>
    <item>golden apple</item>
    <item>monster egg</item>
</itemkeep>
<kill-rewards>
    <kill-reward>
        <item amount="8" material="arrow"/>
        <item amount="16" material="wood"/>
        <item amount="16" material="glass"/>
    </kill-reward>
</kill-rewards>
<maxbuildheight>32</maxbuildheight>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
