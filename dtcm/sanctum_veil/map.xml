<map proto="1.5.1">
<name>Sanctum Veil</name>
<version>1.0.0</version>
<phase>development</phase>
<objective>Destroy the enemy Narthex Reliquary to unseal their Sanctum, then destroy the Sanctum Reliquary.</objective>
<gamemode>dtm</gamemode>
<created>2026-10-16</created>
<authors>
    <author uuid="c25a6f7b-4c42-40da-8cd6-add53f0c84eb"/> <!-- arcadeboss -->
    <author>GrokBot</author>
</authors>
<constants>
    <constant id="gate-fallback">10m</constant> <!-- every sanctum gate opens -->
    <constant id="gold-mode">20m</constant> <!-- monuments -> gold block -->
    <constant id="glass-mode">30m</constant> <!-- monuments -> black stained glass -->
    <constant id="team-max">20</constant> <!-- players per team (20v20) -->
</constants>
<include id="gapple-kill-reward"/>
<include id="void-death"/>
<rules>
    <rule>Each team guards two emerald reliquaries: the Narthex on its temple porch and the Sanctum behind its altar.</rule>
    <rule>A Sanctum is sealed until its own Narthex is destroyed. At ${gate-fallback} every Sanctum unseals.</rule>
    <rule>Defenders reach their Sanctum through the ambulatory door behind the altar. Enemies can never use it.</rule>
    <rule>Boats, buckets, minecarts, TNT and flint and steel cannot be crafted.</rule>
</rules>
<teams>
    <team id="red-team" color="dark red" max="${team-max}">Red</team>
    <team id="blue-team" color="blue" max="${team-max}">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" material="iron sword" unbreakable="true"/>
        <item slot="1" material="bow" unbreakable="true" enchantment="infinity"/>
        <item slot="2" material="diamond pickaxe" unbreakable="true"/>
        <item slot="3" material="iron axe" unbreakable="true"/>
        <item slot="4" material="wood" amount="64"/>
        <item slot="5" material="glass" amount="32"/>
        <item slot="8" material="golden apple"/>
        <item slot="28" material="arrow"/>
        <item slot="30" material="iron spade" unbreakable="true"/>
        <item slot="31" material="wood" amount="64"/>
        <helmet material="leather helmet" team-color="true" unbreakable="true"/>
        <chestplate material="leather chestplate" team-color="true" unbreakable="true"/>
        <leggings material="chainmail leggings" unbreakable="true"/>
        <boots material="leather boots" team-color="true" unbreakable="true"/>
        <effect duration="3s" amplifier="255">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn-kit" region="red-spawn-pad" yaw="-90" pitch="0"/>
    <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-pad" yaw="90" pitch="0"/>
    <default region="observer-point" yaw="-90" pitch="0"/>
</spawns>
<variables>
    <variable id="gates_crumbled" scope="match" default="0"/>
</variables>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
    <any id="red-gate-open"> <!-- own narthex destroyed, or the ${gate-fallback} mode -->
        <completed>red-narthex</completed>
        <variable var="gates_crumbled">1</variable>
    </any>
    <not id="red-gate-closed">
        <filter id="red-gate-open"/>
    </not>
    <any id="blue-gate-open"> <!-- own narthex destroyed, or the ${gate-fallback} mode -->
        <completed>blue-narthex</completed>
        <variable var="gates_crumbled">1</variable>
    </any>
    <not id="blue-gate-closed">
        <filter id="blue-gate-open"/>
    </not>
    <any id="river-water"> <!-- bank block-break filter: allow (water replaced by a placed block), deny everything else -->
        <material>water</material>
        <material>stationary water</material>
    </any>
    <blocks id="sanctum-was-air" region="sanctum-build-volume"> <!-- original air only: placed blocks may be removed, map blocks may not -->
        <material>air</material>
    </blocks>
    <blocks id="narthex-was-air" region="narthex-build-volume">
        <material>air</material>
    </blocks>
    <blocks id="cathedral-was-air" region="cathedral-build">
        <material>air</material>
    </blocks>
    <blocks id="hall-door-was-air" region="hall-doors">
        <material>air</material>
    </blocks>
    <all id="hall-door-break"> <!-- doorway loaded as air; the pasted iron-bar seal stays -->
        <filter id="hall-door-was-air"/>
        <not>
            <material>iron fence</material>
        </not>
    </all>
</filters>
<actions>
    <action id="intro" scope="match">
        <message text="`7Destroy the enemy `6`lNarthex`7 to unseal their Sanctum."/>
        <message text="`7Every Sanctum opens at `6${gate-fallback}`7."/>
    </action>
    <trigger scope="match" filter="match-started" action="intro"/>
    <action id="crumble" scope="match">
        <set var="gates_crumbled" value="1"/>
        <message text="`7The Sanctum gates `6`lcrumble`7: every Sanctum is now open." title="`6The gates crumble" subtitle="`7Every Sanctum is open" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <action id="red-gate-announce" scope="match" filter="gates_crumbled=0"> <!-- narthex-caused opening only; the crumble mode announces itself -->
        <message text="`7The `4Red`7 Narthex has fallen: the `4Red`7 Sanctum is `6`lopen`7." title="`4Red Sanctum `6`lopen" subtitle="`7Its Narthex has fallen" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <trigger scope="match" filter="red-gate-open" action="red-gate-announce"/>
    <action id="blue-gate-announce" scope="match" filter="gates_crumbled=0"> <!-- narthex-caused opening only; the crumble mode announces itself -->
        <message text="`7The `9Blue`7 Narthex has fallen: the `9Blue`7 Sanctum is `6`lopen`7." title="`9Blue Sanctum `6`lopen" subtitle="`7Its Narthex has fallen" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <trigger scope="match" filter="blue-gate-open" action="blue-gate-announce"/>
</actions>
