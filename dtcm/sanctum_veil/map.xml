    <structure id="blue-clerestory-south-seal" region="blue-clerestory-south-stash"/>
    <structure id="blue-ambulatory-seal" region="blue-ambulatory-stash"/>
    <dynamic structure="red-door-seal" trigger="red-gate-closed" offset="84,38,0"/>
    <dynamic structure="red-clerestory-north-seal" trigger="red-gate-closed" offset="80,47,0"/>
    <dynamic structure="red-clerestory-south-seal" trigger="red-gate-closed" offset="80,47,0"/>
