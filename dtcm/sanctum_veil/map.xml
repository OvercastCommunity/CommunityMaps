<map proto="1.5.1">
<name>Sanctum Veil</name>
<version>1.0.1</version>
<phase>development</phase>
<objective>Destroy the enemy Narthex monument to unseal their Sanctum, then destroy the Sanctum monument.</objective>
<gamemode>dtm</gamemode>
<created>2026-10-16</created>
<authors>
    <author uuid="c25a6f7b-4c42-40da-8cd6-add53f0c84eb"/> <!-- arcadeboss -->
    <author>GrokBot</author>
</authors>
<constants>
    <constant id="gate-fallback">10m</constant> <!-- every sanctum gate opens -->
    <constant id="gold-mode">20m</constant> <!-- monuments -> gold block -->
    <constant id="glass-mode">30m</constant> <!-- monuments -> black stained glass -->
    <constant id="team-max">20</constant> <!-- players per team (20v20) -->
</constants>
<include id="gapple-kill-reward"/>
<include id="void-death"/>
<rules>
    <rule>Each team guards two emerald reliquaries: the Narthex on its temple porch and the Sanctum behind its altar.</rule>
    <rule>A Sanctum is sealed until its own Narthex is destroyed. At ${gate-fallback} every Sanctum unseals.</rule>
    <rule>Defenders reach their Sanctum through the ambulatory door behind the altar. Enemies can never use it.</rule>
    <rule>Boats, buckets, minecarts, TNT and flint and steel cannot be crafted.</rule>
</rules>
<teams>
    <team id="red-team" color="dark red" max="${team-max}">Red</team>
    <team id="blue-team" color="blue" max="${team-max}">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" material="iron sword" unbreakable="true"/>
        <item slot="1" material="bow" unbreakable="true" enchantment="infinity"/>
        <item slot="2" material="diamond pickaxe" unbreakable="true"/>
        <item slot="3" material="iron axe" unbreakable="true"/>
        <item slot="4" material="wood" amount="64"/>
        <item slot="5" material="glass" amount="32"/>
        <item slot="8" material="golden apple"/>
        <item slot="28" material="arrow"/>
        <item slot="30" material="iron spade" unbreakable="true"/>
        <item slot="31" material="wood" amount="64"/>
        <helmet material="leather helmet" team-color="true" unbreakable="true"/>
        <chestplate material="leather chestplate" team-color="true" unbreakable="true"/>
        <leggings material="chainmail leggings" unbreakable="true"/>
        <boots material="leather boots" team-color="true" unbreakable="true"/>
        <effect duration="3s" amplifier="255">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn-kit" region="red-spawn-pad" yaw="-90" pitch="0"/>
    <spawn team="blue-team" kit="spawn-kit" region="blue-spawn-pad" yaw="90" pitch="0"/>
    <default region="observer-point" yaw="180" pitch="18"/>
</spawns>
<variables>
    <variable id="gates_crumbled" scope="match" default="0"/>
</variables>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
    <any id="red-gate-open"> <!-- own narthex destroyed, or the ${gate-fallback} mode -->
        <completed>red-narthex</completed>
        <variable var="gates_crumbled">1</variable>
    </any>
    <not id="red-gate-closed">
        <filter id="red-gate-open"/>
    </not>
    <any id="blue-gate-open"> <!-- own narthex destroyed, or the ${gate-fallback} mode -->
        <completed>blue-narthex</completed>
        <variable var="gates_crumbled">1</variable>
    </any>
    <not id="blue-gate-closed">
        <filter id="blue-gate-open"/>
    </not>
</filters>
<actions>
    <action id="intro" scope="match">
        <message text="`7Destroy the enemy `6`lNarthex`7 to unseal their Sanctum."/>
        <message text="`7Every Sanctum opens at `6${gate-fallback}`7."/>
    </action>
    <trigger scope="match" filter="match-started" action="intro"/>
    <action id="crumble" scope="match">
        <set var="gates_crumbled" value="1"/>
        <message text="`7The Sanctum gates `6`lcrumble`7: every Sanctum is now open." title="`6The gates crumble" subtitle="`7Every Sanctum is open" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <action id="red-gate-announce" scope="match" filter="gates_crumbled=0"> <!-- narthex-caused opening only; the crumble mode announces itself -->
        <message text="`7The `4Red`7 Narthex has fallen: the `4Red`7 Sanctum is `6`lopen`7." title="`4Red Sanctum `6`lopen" subtitle="`7Its Narthex has fallen" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <trigger scope="match" filter="red-gate-open" action="red-gate-announce"/>
    <action id="blue-gate-announce" scope="match" filter="gates_crumbled=0"> <!-- narthex-caused opening only; the crumble mode announces itself -->
        <message text="`7The `9Blue`7 Narthex has fallen: the `9Blue`7 Sanctum is `6`lopen`7." title="`9Blue Sanctum `6`lopen" subtitle="`7Its Narthex has fallen" fade-in="0.5s" stay="2.5s" fade-out="1s"/>
        <sound preset="alert"/>
    </action>
    <trigger scope="match" filter="blue-gate-open" action="blue-gate-announce"/>
</actions>
<structures>
    <!-- Iron-bar copies sit outside the map. At load they are cleared and pasted into the doorways, which are air. -->
    <structure id="red-door-seal" region="red-door-stash"/>
    <structure id="red-clerestory-north-seal" region="red-clerestory-north-stash"/>
    <structure id="red-clerestory-south-seal" region="red-clerestory-south-stash"/>
    <structure id="red-ambulatory-seal" region="red-ambulatory-stash"/>
    <structure id="blue-door-seal" region="blue-door-stash"/>
    <structure id="blue-clerestory-north-seal" region="blue-clerestory-north-stash"/>
    <structure id="blue-clerestory-south-seal" region="blue-clerestory-south-stash"/>
    <structure id="blue-ambulatory-seal" region="blue-ambulatory-stash"/>
    <dynamic structure="red-door-seal" trigger="red-gate-closed" offset="84,38,0"/>
    <dynamic structure="red-clerestory-north-seal" trigger="red-gate-closed" offset="80,47,0"/>
    <dynamic structure="red-clerestory-south-seal" trigger="red-gate-closed" offset="80,47,0"/>
    <dynamic structure="red-ambulatory-seal" trigger="red-gate-closed" offset="64,32,0"/>
    <dynamic structure="blue-door-seal" trigger="blue-gate-closed" offset="-84,38,0"/>
    <dynamic structure="blue-clerestory-north-seal" trigger="blue-gate-closed" offset="-80,47,0"/>
    <dynamic structure="blue-clerestory-south-seal" trigger="blue-gate-closed" offset="-80,47,0"/>
    <dynamic structure="blue-ambulatory-seal" trigger="blue-gate-closed" offset="-64,32,0"/>
</structures>
<regions>
    <point id="observer-point">0.5,78,77.5</point> <!-- feet on the glass at 0,77,77, one block closer to center -->
    <point id="gapple-spawn">0,52,0</point> <!-- sea lantern; the apple drops in the air above -->
    <!-- Red -->
    <cuboid id="red-spawn-pad" min="-135,47,-3" max="-128,48,4"/>
    <cuboid id="red-door-stash" min="-155,5,-2" max="-154,10,3"/>
    <cuboid id="red-clerestory-north-stash" min="-156,5,-10" max="-155,8,-9"/>
    <cuboid id="red-clerestory-south-stash" min="-156,5,10" max="-155,8,11"/>
    <cuboid id="red-ambulatory-stash" min="-155,11,-1" max="-154,14,2"/>
    <cuboid id="red-ambulatory" min="-91,43,-1" max="-90,46,2"/>
    <cuboid id="red-narthex-cells" min="-37,45,-1" max="-34,48,2"/>
    <cuboid id="red-sanctum-cells" min="-83,46,-1" max="-80,51,2"/>
    <cuboid id="red-spawn-protection-airspace" min="-139,40,-19" max="-115,256,20"/> <!-- spawn; enemies cannot enter, up to the sky -->
    <cuboid id="red-spawn-blocks" min="-139,40,-19" max="-115,57,20"/> <!-- spawn structure: blocks x=-139..-116, y=40..56, z=-19..19 -->
    <cuboid id="red-sacristy-yard-airspace" min="-124,40,-5" max="-91,256,6"/> <!-- sacristy yard; enemies cannot enter, up to the sky -->
    <!-- Blue -->
    <cuboid id="blue-spawn-pad" min="128,47,-4" max="135,48,3"/>
    <cuboid id="blue-door-stash" min="154,5,-3" max="155,10,2"/>
    <cuboid id="blue-clerestory-north-stash" min="155,5,9" max="156,8,10"/>
    <cuboid id="blue-clerestory-south-stash" min="155,5,-11" max="156,8,-10"/>
    <cuboid id="blue-ambulatory-stash" min="154,11,-2" max="155,14,1"/>
    <cuboid id="blue-ambulatory" min="90,43,-2" max="91,46,1"/>
    <cuboid id="blue-narthex-cells" min="34,45,-2" max="37,48,1"/>
    <cuboid id="blue-sanctum-cells" min="80,46,-2" max="83,51,1"/>
    <cuboid id="blue-spawn-protection-airspace" min="115,40,-20" max="139,256,19"/> <!-- spawn; enemies cannot enter, up to the sky -->
    <cuboid id="blue-spawn-blocks" min="115,40,-20" max="139,57,19"/> <!-- spawn structure: blocks x=115..138, y=40..56, z=-20..18 -->
    <cuboid id="blue-sacristy-yard-airspace" min="91,40,-6" max="124,256,5"/> <!-- sacristy yard; enemies cannot enter, up to the sky -->
    <union id="spawn-blocks"> <!-- both spawn structures; place and break denied -->
        <region id="red-spawn-blocks"/>
        <region id="blue-spawn-blocks"/>
    </union>
    <cuboid id="red-sanctum-secure" min="-91,0,-10" max="-70,256,11"/> <!-- blocks x=-91..-71, y=0..255, z=-10..10; breaks denied until this sanctum opens -->
    <cuboid id="blue-sanctum-secure" min="70,0,-11" max="91,256,10"/> <!-- blocks x=70..90, y=0..255, z=-11..9 -->
    <!-- Spawn answers place and break first. Each sanctum column denies breaks until that sanctum opens. The y=0 floor is the boundary: bedrock inside the oval, and air at y=0 is void. -->
    <apply region="spawn-blocks" block="never" message="You may not modify the spawn!"/>
    <apply region="red-sanctum-secure" block-break="red-gate-open" message="The Sanctum is still sealed!"/>
    <apply region="blue-sanctum-secure" block-break="blue-gate-open" message="The Sanctum is still sealed!"/>
    <apply region="red-ambulatory" enter="only-red" message="Only Red may use the Red ambulatory door!"/>
    <apply region="red-spawn-protection-airspace" enter="only-red" message="You may not enter the enemy spawn!"/>
    <apply region="red-sacristy-yard-airspace" enter="only-red" message="Only Red may enter the Red sacristy yard!"/>
    <apply region="blue-ambulatory" enter="only-blue" message="Only Blue may use the Blue ambulatory door!"/>
    <apply region="blue-spawn-protection-airspace" enter="only-blue" message="You may not enter the enemy spawn!"/>
    <apply region="blue-sacristy-yard-airspace" enter="only-blue" message="Only Blue may enter the Blue sacristy yard!"/>
    <apply block="deny(void)" message="You may not build in the void!"/>
</regions>
<spawners>
    <spawner spawn-region="gapple-spawn" player-region="everywhere" delay="20s" max-entities="2">
        <item material="golden apple"/>
    </spawner>
</spawners>
<destroyables materials="emerald block" show-progress="true" required="true" repairable="false" completion="100%" mode-changes="true" sparks="near">
    <destroyable id="red-narthex" owner="red-team" name="Narthex Reliquary" region="red-narthex-cells"/>
    <destroyable id="red-sanctum" owner="red-team" name="Sanctum Reliquary" region="red-sanctum-cells"/>
    <destroyable id="blue-narthex" owner="blue-team" name="Narthex Reliquary" region="blue-narthex-cells"/>
    <destroyable id="blue-sanctum" owner="blue-team" name="Sanctum Reliquary" region="blue-sanctum-cells"/>
</destroyables>
<modes>
    <mode id="gates-crumble" after="${gate-fallback}" name="`6The Sanctum gates crumble" action="crumble" show-before="1m"/>
    <mode id="gold-mode" after="${gold-mode}" material="gold block" name="`6Gold Monument Mode" show-before="1m"/>
    <mode id="glass-mode" after="${glass-mode}" material="stained glass:15" name="`8Black Glass Monument Mode" show-before="1m"/>
</modes>
<crafting>
    <disable>boat</disable>
    <disable>bucket</disable>
    <disable>flint and steel</disable>
    <disable>minecart</disable>
    <disable>tnt</disable>
</crafting>
<kill-rewards>
    <kill-reward>
        <item material="wood" amount="20"/>
    </kill-reward>
</kill-rewards>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>diamond pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
</toolrepair>
<itemremove>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>chainmail leggings</item>
    <item>leather boots</item>
    <item>iron helmet</item>
    <item>iron chestplate</item>
    <item>iron leggings</item>
    <item>iron boots</item>
    <item>emerald block</item>
    <item>gold block</item>
    <item>obsidian</item>
    <item>iron fence</item>
    <item>boat</item>
    <item>minecart</item>
    <item>bucket</item>
    <item>flint and steel</item>
    <item>seeds</item>
    <item>sapling</item>
    <item>string</item>
</itemremove>
<itemkeep>
    <item>iron sword</item>
    <item>bow</item>
    <item>diamond pickaxe</item>
    <item>iron axe</item>
    <item>iron spade</item>
    <item>golden apple</item>
    <item>wood</item>
    <item>arrow</item>
    <item>glass</item>
</itemkeep>
<hunger>
    <depletion>off</depletion>
</hunger>
<gamerules>
    <doFireTick>false</doFireTick>
    <randomTickSpeed>0</randomTickSpeed> <!-- no grass spread, no crop growth, no leaf decay -->
    <mobGriefing>false</mobGriefing> <!-- no mob block damage -->
</gamerules>
<world>
    <timeset>1000</timeset> <!-- morning (1000 = 07:00); a full day is 24000 ticks = 20 min -->
    <timelock>off</timelock> <!-- PGM locks time by default; off = day/night cycle (sets doDaylightCycle) -->
</world>
<maxbuildheight>72</maxbuildheight>
</map>
