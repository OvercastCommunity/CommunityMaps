<regions>
    <cuboid id="buildable" min="-160,40,-70" max="160,256,70"/>
    <negative id="out-of-bounds">
        <region id="buildable"/>
    </negative>
    <cuboid id="red-monument" min="94,111,35" max="97,115,38"/>
    <cuboid id="blue-monument" min="-97,111,-38" max="-94,115,-35"/>
    <union id="monuments">
        <region id="red-monument"/>
        <region id="blue-monument"/>
    </union>
    <cuboid id="red-spawn-protect" min="106,104,-42" max="131,256,-17"/>
    <cuboid id="blue-spawn-protect" min="-131,104,17" max="-106,256,42"/>
    <union id="spawn-protections">
        <region id="red-spawn-protect"/>
        <region id="blue-spawn-protect"/>
    </union>
    <rectangle id="red-spawn-resist" min="111,-37" max="126,-22"/>
    <rectangle id="blue-spawn-resist" min="-126,22" max="-111,37"/>
    <rectangle id="red-home" min="0,-70" max="160,70"/>
    <rectangle id="blue-home" min="-160,-70" max="0,70"/>
    <apply region="out-of-bounds" block="never" message="You may not build outside the playable area!"/>
    <apply region="red-spawn-protect" enter="only-red" message="You may not enter the enemy spawn!"/>
    <apply region="blue-spawn-protect" enter="only-blue" message="You may not enter the enemy spawn!"/>
    <apply region="spawn-protections" block="never" message="You may not modify the spawn area!"/>
    <apply region="red-spawn-resist" lend-kit="spawn-resist"/>
    <apply region="blue-spawn-resist" lend-kit="spawn-resist"/>
</regions>
<destroyables name="Monument" materials="obsidian;emerald block" show-progress="true" required="true" repairable="false" sparks="near">
    <destroyable owner="red-team" region="red-monument"/>
    <destroyable owner="blue-team" region="blue-monument"/>
</destroyables>
<block-drops>
    <rule>
        <region>
            <region id="monuments"/>
        </region>
        <filter>
            <material>emerald block</material>
        </filter>
        <drops>
            <item amount="5" material="emerald"/>
            <item chance="0.75" amount="1" material="emerald"/>
            <item chance="0.5" amount="1" material="emerald"/>
            <item chance="0.25" amount="1" material="emerald"/>
        </drops>
    </rule>
</block-drops>
<spawners>
