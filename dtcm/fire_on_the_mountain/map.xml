<map proto="1.5.1">
<name>Fire on the Mountain</name>
<version>1.2.0</version>
<objective>Destroy the enemy monument.</objective>
<created>2026-08-23</created>
<phase>development</phase>
<include id="gapple-kill-reward"/>
<authors>
    <author uuid="c25a6f7b-4c42-40da-8cd6-add53f0c84eb"/> <!-- arcadeboss -->
    <author>GrokBuild</author>
</authors>
<gamemode>dtm</gamemode>
<teams>
    <team id="red-team" color="dark red" max="25">Red</team>
    <team id="blue-team" color="blue" max="25">Blue</team>
</teams>
<broadcasts>
    <alert after="1m">Emeralds dropped from the monuments can be used to buy team upgrades!</alert>
</broadcasts>
<kits>
    <kit id="spawn">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" material="bow">
            <enchantment>infinity</enchantment>
        </item>
        <item slot="28" amount="1" material="arrow"/>
        <item slot="2" unbreakable="true" material="diamond pickaxe"/>
        <item slot="3" unbreakable="true" material="iron axe"/>
        <item slot="4" unbreakable="true" material="iron spade"/>
        <item slot="5" amount="64" material="wood"/>
        <item slot="6" amount="32" material="wood"/>
        <item slot="8" amount="1" material="golden apple"/>
        <item slot="32" amount="16" material="cobblestone"/>
        <item slot="35" amount="4" material="torch"/>
        <helmet team-color="true" unbreakable="true" material="leather helmet"/>
        <chestplate team-color="true" unbreakable="true" material="leather chestplate">
            <enchantment level="1">protection</enchantment>
        </chestplate>
        <leggings team-color="true" unbreakable="true" material="leather leggings"/>
        <boots team-color="true" unbreakable="true" material="leather boots"/>
        <effect duration="5" amplifier="0">damage resistance</effect>
    </kit>
    <kit id="spawn-resist">
        <effect duration="oo" amplifier="0">damage resistance</effect>
    </kit>
    <kit id="flint-kit" force="true" deduct-items="false">
        <item material="flint and steel" amount="1"/>
    </kit>
    <kit id="diamond-sword-kit" force="true" deduct-items="false">
        <item unbreakable="true" material="diamond sword" enchantment="sharpness:1"/>
    </kit>
    <kit id="auto-tnt-kit" force="true" deduct-items="false">
        <item material="tnt" amount="3"/>
    </kit>
    <kit id="diamond-shovel-kit" force="true" deduct-items="false">
        <item unbreakable="true" material="diamond spade" enchantment="efficiency:2"/>
    </kit>
    <kit id="diamond-axe-kit" force="true" deduct-items="false">
        <item unbreakable="true" material="diamond axe" enchantment="efficiency:2"/>
    </kit>
    <kit id="cobweb-kit" force="true" deduct-items="false">
        <item material="web" amount="8"/>
    </kit>
    <kit id="water-bucket-kit" force="true" deduct-items="false">
        <item material="water bucket" amount="1"/>
    </kit>
    <lend filter="apply-speed">
        <kit>
            <effect>speed</effect>
        </kit>
    </lend>
    <give filter="apply-haste">
        <kit>
            <effect>haste</effect>
        </kit>
    </give>
</kits>
<spawns>
    <spawn team="red-team" kit="spawn" yaw="19.2" pitch="3">
        <regions>
            <cuboid min="118,115,-30" max="119,118,-29"/>
        </regions>
    </spawn>
    <spawn team="blue-team" kit="spawn" yaw="-160.8" pitch="3">
        <regions>
            <cuboid min="-119,115,29" max="-118,118,30"/>
        </regions>
    </spawn>
    <default yaw="0" pitch="20">
        <regions>
            <point>0.5,136,-79.5</point>
        </regions>
    </default>
</spawns>
<variables>
    <variable id="armor_variable" default="0" scope="team"/>
    <variable id="axe_shovel_variable" default="0" scope="team"/>
    <variable id="protection_variable" default="0" scope="team"/>
    <variable id="sharpness_variable" default="0" scope="team"/>
    <variable id="speed_variable" default="0" scope="team"/>
    <variable id="haste_variable" default="0" scope="team"/>
</variables>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
    <variable id="armor-0" var="armor_variable">0</variable>
    <variable id="armor-1" var="armor_variable">1</variable>
    <variable id="axe-shovel-0" var="axe_shovel_variable">0</variable>
    <variable id="axe-shovel-1" var="axe_shovel_variable">1</variable>
    <variable id="protection-0" var="protection_variable">0</variable>
    <variable id="protection-1" var="protection_variable">1</variable>
    <variable id="protection-2" var="protection_variable">2</variable>
    <variable id="protection-3" var="protection_variable">3</variable>
    <variable id="sharpness-0" var="sharpness_variable">0</variable>
    <variable id="sharpness-1" var="sharpness_variable">1</variable>
    <variable id="sharpness-2" var="sharpness_variable">2</variable>
    <variable id="speed-0" var="speed_variable">0</variable>
    <variable id="haste-0" var="haste_variable">0</variable>
    <all id="apply-protection-1">
        <variable var="protection_variable">1</variable>
        <alive/>
    </all>
    <all id="apply-protection-2">
        <variable var="protection_variable">2</variable>
        <alive/>
    </all>
    <all id="apply-protection-3">
        <variable var="protection_variable">3</variable>
        <alive/>
    </all>
    <all id="apply-sharpness-1">
        <variable var="sharpness_variable">1</variable>
        <alive/>
    </all>
    <all id="apply-sharpness-2">
        <variable var="sharpness_variable">2</variable>
        <alive/>
    </all>
    <all id="apply-armor-0">
        <alive/>
        <variable var="armor_variable">1</variable>
        <variable var="protection_variable">0</variable>
    </all>
    <all id="apply-armor-1">
        <alive/>
        <variable var="armor_variable">1</variable>
        <variable var="protection_variable">1</variable>
    </all>
    <all id="apply-armor-2">
        <alive/>
        <variable var="armor_variable">1</variable>
        <variable var="protection_variable">2</variable>
    </all>
    <all id="apply-armor-3">
        <alive/>
        <variable var="armor_variable">1</variable>
        <variable var="protection_variable">3</variable>
    </all>
    <all id="apply-axe-shovel">
        <alive/>
        <variable var="axe_shovel_variable">1</variable>
    </all>
    <all id="apply-speed">
        <alive/>
        <any>
            <all>
                <team>red-team</team>
                <region id="red-home"/>
                <variable var="speed_variable" team="red-team">1</variable>
            </all>
            <all>
                <team>blue-team</team>
                <region id="blue-home"/>
                <variable var="speed_variable" team="blue-team">1</variable>
            </all>
        </any>
    </all>
    <all id="apply-haste">
        <alive/>
        <any>
            <all>
                <team>red-team</team>
                <variable var="haste_variable" team="red-team">1</variable>
            </all>
            <all>
                <team>blue-team</team>
                <variable var="haste_variable" team="blue-team">1</variable>
            </all>
        </any>
    </all>
</filters>
<actions>
    <action id="protection-set-1" scope="player">
        <set var="protection_variable" value="1"/>
        <switch-scope inner="team">
            <sound key="block.beacon.activate" volume="0.9" pitch="1"/>
        </switch-scope>
    </action>
    <action id="protection-set-2" scope="player">
        <set var="protection_variable" value="2"/>
        <switch-scope inner="team">
            <sound key="block.beacon.activate" volume="0.9" pitch="1"/>
        </switch-scope>
    </action>
    <action id="protection-set-3" scope="player">
        <set var="protection_variable" value="3"/>
        <switch-scope inner="team">
            <sound key="block.beacon.activate" volume="0.9" pitch="1"/>
