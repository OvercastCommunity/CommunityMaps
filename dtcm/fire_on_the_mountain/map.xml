                <payment price="15" currency="emerald" color="green"/>
            </item>
            <item material="iron leggings" amount="3" enchantment="protection:3" name="`aProtection III" filter="protection-2" action="protection-set-3" lore="`7Your team permanently gains|`7Protection III on leggings and boots.||`7Tier 1: Protection I`7, `a10 Emeralds|`7Tier 2: Protection II`7, `a15 Emeralds|`7Tier 3: `aProtection III`7, `a20 Emeralds|">
