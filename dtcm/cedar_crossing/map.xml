<?xml version="1.0" encoding="UTF-8"?>
<map proto="1.5.0">
<name>Cedar Crossing</name>
<version>1.0.1</version>
<include id="gapple-kill-reward"/>
<objective>Destroy the enemy team's obsidian monument.</objective>
<created>2026-07-27</created>
<authors>
    <author uuid="c25a6f7b-4c42-40da-8cd6-add53f0c84eb" contribution="7,000 word essay"/>
    <author contribution="Map and XML">SuperGrok</author>
</authors>
<contributors>
    <contributor uuid="510dae51-f405-4cf4-9fb6-6f1fd3f07d69" contribution="Map suggestions"/>
</contributors>
<teams>
    <team id="red-team" color="dark red" max="18">Red</team>
    <team id="blue-team" color="blue" max="18">Blue</team>
</teams>
<kits>
    <kit id="spawn-kit">
        <clear/>
        <item slot="0" unbreakable="true" material="iron sword"/>
        <item slot="1" unbreakable="true" material="bow">
            <enchantment>infinity</enchantment>
        </item>
        <item slot="28" amount="1" material="arrow"/>
        <item slot="2" unbreakable="true" material="diamond pickaxe"/>
        <item slot="3" unbreakable="true" material="iron axe"/>
        <item slot="4" unbreakable="true" material="iron spade"/>
        <item slot="5" amount="64" material="wood"/>
        <item slot="6" amount="32" material="glass"/>
        <item slot="8" amount="2" material="golden apple"/>
        <item slot="32" amount="16" material="cobblestone"/>
        <item slot="35" amount="4" material="torch"/>
        <helmet team-color="true" unbreakable="true" material="leather helmet"/>
        <chestplate team-color="true" unbreakable="true" material="leather chestplate">
            <enchantment level="1">protection</enchantment>
        </chestplate>
        <leggings team-color="true" unbreakable="true" material="leather leggings"/>
        <boots team-color="true" unbreakable="true" material="leather boots"/>
        <effect duration="5" amplifier="0">damage resistance</effect>
    </kit>
</kits>
<spawns>
    <spawn team="blue-team" kit="spawn-kit">
        <regions yaw="41.5">
            <point>95.5,80,-52.5</point>
        </regions>
    </spawn>
    <spawn team="red-team" kit="spawn-kit">
        <regions yaw="221.5">
            <point>-94.5,80,53.5</point>
        </regions>
    </spawn>
    <default>
        <regions yaw="0" pitch="22">
            <point>0.5,106,-60.5</point>
        </regions>
    </default>
</spawns>
<maxbuildheight>97</maxbuildheight>
<tnt>
    <instantignite>true</instantignite>
    <blockdamage>true</blockdamage>
    <friendly-defuse>off</friendly-defuse>
    <fuse>3s</fuse>
    <yield>1</yield>
    <power>3.25</power>
</tnt>
<gamerules>
    <doFireTick>false</doFireTick>
</gamerules>
<regions>
    <cuboid id="buildable" min="-100,1,-65" max="101,256,66"/>
    <negative id="out-of-bounds">
        <region id="buildable"/>
    </negative>
    <cuboid id="red-spawn-protect" min="-100,71,40" max="-80,256,65"/>
    <cuboid id="blue-spawn-protect" min="80,71,-65" max="100,256,-40"/>
    <cuboid id="red-monument" min="-55,81,-0.5" max="-54,83,0.5"/>
    <cuboid id="blue-monument" min="55,81,-0.5" max="56,83,0.5"/>
    <cuboid id="red-indicator" min="-56,101,-1" max="-54,106,1"/>
    <cuboid id="blue-indicator" min="54,101,-1" max="56,106,1"/>
    <union id="monument-indicators">
        <region id="red-indicator"/>
        <region id="blue-indicator"/>
    </union>
    <cuboid id="red-platform-light" min="-55,74,0" max="-54,75,1"/>
    <cuboid id="blue-platform-light" min="55,74,0" max="56,75,1"/>
    <union id="platform-lights">
        <region id="red-platform-light"/>
        <region id="blue-platform-light"/>
    </union>
    <union id="spawn-protections">
        <region id="red-spawn-protect"/>
        <region id="blue-spawn-protect"/>
    </union>
    <apply region="out-of-bounds" block="never" message="You may not build outside the playable area!"/>
    <apply region="red-spawn-protect" enter="only-red" message="You may not enter the enemy spawn!"/>
    <apply region="blue-spawn-protect" enter="only-blue" message="You may not enter the enemy spawn!"/>
    <apply region="spawn-protections" block="never" message="You may not modify the spawn area!"/>
    <apply region="monument-indicators" block="never" message="You may not break the monument indicators!"/>
    <apply region="platform-lights" block="never"/>
</regions>
<filters>
    <team id="only-red">red-team</team>
    <team id="only-blue">blue-team</team>
</filters>
<destroyables name="Monument" materials="obsidian" mode-changes="true">
    <destroyable owner="red-team" region="red-monument"/>
    <destroyable owner="blue-team" region="blue-monument"/>
</destroyables>
<modes>
    <mode material="beacon" after="20m"/>
</modes>
<itemremove>
    <item>obsidian</item>
    <item>beacon</item>
    <item>leather helmet</item>
    <item>leather chestplate</item>
    <item>leather leggings</item>
    <item>leather boots</item>
</itemremove>
<toolrepair>
    <tool>iron sword</tool>
    <tool>bow</tool>
    <tool>diamond pickaxe</tool>
    <tool>iron axe</tool>
    <tool>iron spade</tool>
</toolrepair>
<itemkeep>
    <item>wood</item>
    <item>cobblestone</item>
    <item>glass</item>
    <item>golden apple</item>
    <item>iron sword</item>
    <item>bow</item>
    <item>diamond pickaxe</item>
    <item>iron axe</item>
    <item>iron spade</item>
    <item>arrow</item>
    <item>torch</item>
</itemkeep>
<kill-rewards>
    <kill-reward>
        <item amount="16" material="wood"/>
    </kill-reward>
    <kill-reward>
        <item amount="2" material="tnt"/>
        <filter>
            <kill-streak count="4" repeat="true"/>
        </filter>
    </kill-reward>
</kill-rewards>
<gamerules>
    <doDaylightCycle>true</doDaylightCycle>
</gamerules>
<world>
    <timeset>23900</timeset>
    <timelock>off</timelock>
</world>
<hunger>
    <depletion>off</depletion>
</hunger>
</map>
